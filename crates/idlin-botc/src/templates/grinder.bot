// ============================================================
// Idlin grinder template — the default chat-player brain.
//
// Per tick: read status; if dead, wait. Pick up our loot, run
// gear/passive/gem upkeep, then fight the nearest enemy —
// leading with the first READY skill gem aimed per its declared
// targeting mode, budgeting mana, falling back to the basic
// attack. Wander when nothing is around.
//
// See docs/bot-guide.md for the syscall reference.
// ============================================================

// Node numbers from the tree map page (content/tree/core.ron `num`).
// Default build: a Warbringer bruiser splashing Bulwark for survival.
const N_STR1 = 10;
const N_STR2 = 11;
const N_MIGHT = 12;
const N_HEFT = 20;         // Warbringer limb
const N_BRAWN = 21;
const N_RHYTHM = 22;
const N_BUTCHER = 23;
const N_OVERWHELM = 24;
const N_BERSERKER = 25;
const N_SOCKET_WAR = 26;
const N_THICK_SKIN = 30;   // Bulwark limb
const N_HARDY = 31;
const N_STALWART = 32;
const N_COLOSSUS = 33;
const N_IRON_WILL = 34;
const N_SOCKET_AEGIS = 36;
const N_SUREFOOT = 112;    // bridge toward Wind Dancer
const N_POISE = 60;
const N_FLEET = 61;

// The declared build: allocated automatically as we level. The whole
// plan is fixed at deploy — changing it means deploying a new bot.
build [
    N_STR1, N_STR2, N_MIGHT,
    N_HEFT, N_SOCKET_WAR, N_BRAWN, N_RHYTHM, N_BUTCHER,
    N_THICK_SKIN, N_HARDY, N_SOCKET_AEGIS, N_STALWART, N_COLOSSUS,
    N_OVERWHELM, N_BERSERKER, N_IRON_WILL,
    N_SUREFOOT, N_FLEET, N_POISE,
];

const SELF = 0xE000;       // SelfStatus buffer
const ENTS = 0xE100;       // entity query buffer (24-byte records)
const SKL = 0xE400;        // ReadSkills records (48 bytes each)
const F_ENEMY = 1;
const F_LOOT = 3;

var last_level;            // speech-bubble beat on level up

// Fire one skill slot at the target, honoring its declared targeting
// mode (record +36; ready checked by the caller). 0 = it flies.
fn fire_skill(rec, slot, target, tx, ty) {
    var mode = mem[rec + 36];
    if (mode == 0) { return use_skill(slot, target, 0, 0); }
    if (mode == 1) { return use_skill_at(slot, tx, ty); }
    return use_skill_dir(slot, tx - mem[SELF], ty - mem[SELF + 4]);
}

fn main() {
    self_status(SELF);
    if (mem[SELF + 32] & 1) { return; }        // dead: wait for respawn

    // A word when the shore concedes a level (speech.ron line 2).
    var lvl = mem[SELF + 16];
    if (last_level == 0) { last_level = lvl; }
    if (lvl > last_level) {
        last_level = lvl;
        say(2);
    }

    // Pick up our loot if any is in sight.
    if (read_entities(ENTS, 4, F_LOOT) > 0) {
        pick_up(mem[ENTS]);
    }

    // Upkeep: gear and gems (passives allocate themselves per the build).
    equip_best();
    socket_gem(-1, -1);

    // Fight the nearest enemy. Attacks are wasted intent without line of
    // sight, so only swing when the lane is clear; either way keep closing
    // distance — movement slides around cover.
    if (read_entities(ENTS, 8, F_ENEMY) > 0) {
        var target = mem[ENTS];
        var tx = mem[ENTS + 8];
        var ty = mem[ENTS + 12];
        if (line_of_sight(tx, ty) == 1) {
            // Mana budget: gem skills only above 20% mana — the basic
            // attack is free, and the pool wants emergency headroom.
            var used = -1;
            if (mem[SELF + 52] * 5 >= mem[SELF + 56]) {
                // First READY skill wins (+44; ready already folds
                // cooldown, mana, use-time, and the weapon gate).
                var n = read_skills(SKL, 4);
                var i = 0;
                while (i < n) {
                    var rec = SKL + i * 48;
                    if (mem[rec + 44] == 1) {
                        used = fire_skill(rec, i + 1, target, tx, ty);
                        if (used == 0) { i = n; }
                    }
                    i = i + 1;
                }
            }
            if (used != 0) {
                use_skill(0, target, 0, 0);
            }
        }
        move_to(tx, ty);
        return;
    }

    // Nothing around: wander somewhere in the zone.
    move_to((random() & 0x7FFFFFFF) % mem[SELF + 24],
            (random() & 0x7FFFFFFF) % mem[SELF + 28]);
}
