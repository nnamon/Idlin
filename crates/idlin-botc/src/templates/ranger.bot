// ============================================================
// Idlin ranger template — the bow-and-distance chat-player brain.
// Forked from the grinder (the three stock brains share DNA — a bug
// fixed in one belongs in all three); the deltas: the Deadeye build,
// the bow ladder, shot sockets, and the ranged hold.
//
// Per tick: read status; if dead, wait. Pick up our loot, run
// gear/passive/gem upkeep, then fight the nearest enemy —
// leading with the first READY skill gem aimed per its declared
// targeting mode, budgeting mana, falling back to the basic
// attack. Wander when nothing is around.
//
// THE SALT ROAD (#136 T6): this brain plays the whole game. Before
// Act 1 is done it pushes DEEPER when leveled for the next zone
// (coast at once, saltworks at 7, the Hollow at 10) and breaks the
// Mother. After (SelfStatus flags bit 1) it lives the endgame loop:
// home to Saltmere, open a map at the Map Device, farm the
// map for ~8 minutes, walk home, repeat — and when it runs dry
// of maps, it returns to the Hollow: the Mother always pays one.
//
// See docs/bot-guide.md for the syscall reference.
// ============================================================

// The declared build: a Warbringer bruiser splashing Bulwark for
// survival. Node refs are the generated NODE_* consts (#54 stable tagged
// nums, from content/lib/gen_ids.bot, prepended by template_grinder) —
// the same ids the tree map page and content-docs publish. Allocated
// automatically as we level; the whole plan is fixed at deploy.
// Sockets sit DEEP (behind each limb's fifth node): the second skill slot
// is a post-shore milestone, not a tutorial snack.
build [
    NODE_DEX1, NODE_DEX2, NODE_DEX3,                        // DEX trunk
    NODE_D1, NODE_D2, NODE_D3, NODE_D4, NODE_D5,            // Deadeye limb
    NODE_HAWKEYE, NODE_SOCKET_HUNT,
    NODE_WD1, NODE_WD2, NODE_WD3, NODE_WD4, NODE_WD5,      // Wind Dancer limb
    NODE_PHANTOM_GRACE, NODE_SOCKET_GALE,
];

const SELF = 0xE000;       // SelfStatus buffer
const ENTS = 0xE100;       // entity query buffer (24-byte records)
const SKL = 0xE400;        // ReadSkills records (40 bytes each)
const EXITS = 0xE700;      // ReadExits records (16 bytes each)
const INV = 0xE800;        // ReadInventory records (20 bytes each)
const EQ = 0xED00;         // ReadEquipment records (16 bytes each)
const F_ENEMY = 1;
const F_LOOT = 3;

var last_level;            // speech-bubble beat on level up
var wander_x;              // exploration: the spot we're strolling toward
var wander_y;
var wander_left;           // ticks before we pick a new spot
var bored;                 // ticks since anything was worth fighting
var leaving;               // committed to an open exit (boredom latch)
var last_zone;             // SelfStatus zone num; transfers reset intent
var stuck_x;               // unstick: position memory + window counter
var stuck_y;
var stuck_t;
var unstick;               // ticks left of forced wandering
var map_t;              // ticks spent in the current map instance
var upkeep_in;             // gear/socket upkeep cadence (budget discipline)
var shed_cd;               // ticks to ignore ground loot after shedding
var last_xp;               // XP-drought: earnings mark real progress
var drought;               // ticks fighting without earning
var spent;                 // ticks in this zone with NOTHING to fight
var spent_zid;             // the zone the spent counter belongs to
var was_dead;              // the dead-bit's edge detector
var shy;                   // post-respawn: don't re-engage the killers
var close_in;              // ticks of forced gap-closing
var strafed;               // the drought already bought one strafe

// Fire one skill slot at the target, honoring its declared targeting
// mode (ReadSkills record +28 = target_mode; ready checked by the
// caller). 0 = it flies.
fn fire_skill(rec, slot, target, tx, ty) {
    var mode = mem[rec + 28];
    if (mode == 0) { return use_skill(slot, target, 0, 0); }
    if (mode == 1) { return use_skill_at(slot, tx, ty); }
    return use_skill_dir(slot, tx - mem[SELF], ty - mem[SELF + SS_Y]);
}

// Socket the planned gem NUM into socket `node`, if a loose copy is in the bag.
// Idempotent: a filled node, or no such gem, returns -1 and we move on next
// tick. socket_gem takes a stable node NUM now (#54 PR3); args are (node, slot).
fn socket_into(node, gem_num) {
    var n = read_inventory(INV, 60);
    var i = 0;
    while (i < n) {
        if (mem[INV + i * INVENTORY_RECORD_SIZE] == gem_num) {
            // socket_gem returns the COUNT socketed (>0 ok, -1 fail). Stop on
            // success: socketing shifts the bag, so the scanned buffer is now
            // stale — a later stale index would point at the wrong item.
            if (socket_gem(node, i) > 0) { return 0; }
        }
        i = i + 1;
    }
    return -1;
}

// Wear the first bag piece that fills an empty slot or out-levels what's worn —
// the manual gear path (vs the equip_best shortcut). item_slot(num) maps a
// candidate to its gear slot; read_equipment gives the worn piece there
// (record: slot, base_num/-1, rarity, item_level). One equip per tick: a swap
// shifts the bag, so we stop and re-scan next tick.
fn upkeep_gear() {
    read_equipment(EQ, 12);                     // ALL gear slots, incl. the
                                                // accessories (rings 7/8, belt 9,
                                                // amulet 10) and gloves (11) —
                                                // item_slot returns those, so the
                                                // records must be written or
                                                // `EQ + s*16` reads stale.
    // ARMOUR + ACCESSORIES: the engine scorer's business (#148 A2.5) —
    // item_score weighs life, armour, ES, evasion, attributes AND RESISTS;
    // the old rarity-first rule wore whatever dropped, and casting bosses
    // farmed the ranged archetypes for it. equip_best never touches the
    // weapon (engine contract) — the ladder below stays ours.
    equip_best();
    var n = read_inventory(INV, 60);
    var i = 0;
    while (i < n) {
        var rec = INV + i * INVENTORY_RECORD_SIZE;
        var num = mem[rec];
        var s = item_slot(num);                 // -1 unless this is gear
        if (s == 0) {
            // The WEAPON slot is build-critical: a wand or bow would silence our
            // melee skills at the weapon gate (the gear face of #52). Reads don't
            // carry weapon class, so we wield only our known melee base; armor
            // upgrades freely by item level. (A STARTER heuristic: item_slot maps
            // flasks to loop 5 and rings to loop 7, so a second same-level flask
            // or ring in the OTHER loop may go unworn — perfecting the twin loops
            // is the optimizing author's job, RFC P4.)
            var ok = 1;
            if (s == 0) {
                // The BOW LADDER (#148 A2): the known bow bases, ranked
                // by base damage — a higher rung always wins; on the same
                // rung, item level breaks the tie below. The whitelist IS
                // the class gate (reads don't carry weapon class; a cleaver
                // or wand would silence the build's shots, #52).
                ok = 0;
                var rank = 0;
                if (num == ITEM_DRIFTWOOD_BOW) { ok = 1; rank = 1; }
                if (num == ITEM_SALTWORKS_RECURVE) { ok = 1; rank = 2; }
                if (num == ITEM_WARDENS_GREATBOW) { ok = 1; rank = 3; }
                if (num == ITEM_KELPSTRUNG_BOW) { ok = 1; rank = 4; }
                if (num == ITEM_RIPTIDE_LONGBOW) { ok = 1; rank = 5; }
                if (ok == 1) {
                    var wnum = mem[EQ + 4];
                    var wrank = 0;
                    if (wnum == ITEM_DRIFTWOOD_BOW) { wrank = 1; }
                    if (wnum == ITEM_SALTWORKS_RECURVE) { wrank = 2; }
                    if (wnum == ITEM_WARDENS_GREATBOW) { wrank = 3; }
                    if (wnum == ITEM_KELPSTRUNG_BOW) { wrank = 4; }
                    if (wnum == ITEM_RIPTIDE_LONGBOW) { wrank = 5; }
                    if (rank < wrank) { ok = 0; }
                    if (rank > wrank) {
                        if (equip(i) == 0) { return; }
                        ok = 0;
                    }
                }
            }
        }
        i = i + 1;
    }
}

// BAG DISCIPLINE (#136 T6): a hoarder's bag is a full bag, and a full
// bag DROPS NOTHING NEW — the Mother's map bounced off one once. When
// the bag runs hot, shed the first NORMAL-rarity gear (never gems, never
// maps): normals are either worn already or losers by definition.
fn shed_trash() {
    var n = read_inventory(INV, 60);
    // The bag fills by CELLS, not count — a dozen 6-cell weapons brick
    // it long before 60 records, pickups fail silently, and the Mother's
    // map bounces (it did AGAIN at 12:
    // weapons it can never wield). Policy: anything upkeep_gear did NOT
    // wear is a loser by definition — keep maps and ONE copy of each
    // build gem, shed the rest (one per pass; drops shift the bag).
    // Eight records keeps a 2x2 hole under any mix.
    if (n < 8) { return 0; }
    var seen_0 = 0;
    var seen_1 = 0;
    var seen_2 = 0;
    var i = 0;
    while (i < n) {
        var rec = INV + i * INVENTORY_RECORD_SIZE;
        var num = mem[rec];
        var keep = 0;
        if (num == ITEM_SALT_STAINED_CHART) { keep = 1; }
        if (num == GEM_POWER_SHOT && seen_0 == 0) { keep = 1; seen_0 = 1; }
        if (num == GEM_SPLIT_QUIVER && seen_1 == 0) { keep = 1; seen_1 = 1; }
        if (num == GEM_QUICKENING && seen_2 == 0) { keep = 1; seen_2 = 1; }
        if (keep == 0) {
            drop_item(i);
            shed_cd = 50;
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// The bag index of a map, or -1.
fn find_map() {
    var n = read_inventory(INV, 60);
    var i = 0;
    while (i < n) {
        if (mem[INV + i * INVENTORY_RECORD_SIZE] == ITEM_SALT_STAINED_CHART) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Where the road leads next: a ZONE_* num to travel, -1 to STAY (this
// zone is the road's business — level-grinding, or the boss lives here;
// the boredom valve must NOT bounce us out: a ranged brain clears the
// Hollow's sparse throat from afar, runs 12 clean seconds, and used to
// ping-pong out of the Mother's own zone forever), or 0 for a zone the
// road doesn't know (the valve applies — no zone may strand us).
fn route_dest() {
    var act1 = mem[SELF + SS_FLAGS] & 2;
    var lvl = mem[SELF + SS_LEVEL];
    var zid = mem[SELF + SS_ZONE];
    // THE ROAD ADVANCES WHEN THE ZONE IS SPENT (operator ruling: monsters
    // never respawn — camping pays nothing). ~30s with nothing to
    // fight overrides every level gate below: there is no XP left here;
    // forward is the only direction that pays.
    if (zid != spent_zid) { spent = 0; spent_zid = zid; }
    if (act1 == 0) {
        // The campaign: press on when strong enough. (The shore's own
        // brain paces the tutorial; when the bluff gate finally opens,
        // the road up to Saltmere is ours to take.)
        if (zid == ZONE_WITHERED_SHORE) { return ZONE_SALTMERE; }
        if (zid == ZONE_SALTMERE) { return ZONE_COAST; }
        if (zid == ZONE_COAST) {
            if (lvl >= 7 || spent > 300) { return ZONE_SALTWORKS; }
            return -1;
        }
        if (zid == ZONE_SALTWORKS) {
            // 12, not 10: the Hollow at 10 was a meat grinder (the T8 band
            // counted 71 deaths on one seed) — two more Saltworks levels
            // turn it into a fight.
            if (lvl >= 12 || spent > 300) { return ZONE_HOLLOW; }
            return -1;
        }
        // The Hollow is the road's business pre-act (the Mother lives
        // here); any OTHER zone is off-road — the boredom valve applies.
        if (zid == ZONE_HOLLOW) { return -1; }
        return 0;
    }
    // ACT 2 (#148 A3): with the first act broken and the second still
    // standing, the road runs DOWN — the Hollow's sealed stair answers to
    // the act-1 bit we carry. Level gates as ever.
    var act2 = mem[SELF + SS_FLAGS] & 4;
    if (act2 == 0) {
        if (zid == ZONE_SALTMERE) { return ZONE_COAST; }
        if (zid == ZONE_COAST) { return ZONE_SALTWORKS; }
        if (zid == ZONE_SALTWORKS) { return ZONE_HOLLOW; }
        if (zid == ZONE_HOLLOW) { return ZONE_SUNKEN_STAIR; }
        if (zid == ZONE_SUNKEN_STAIR) { return ZONE_LANTERNFALL; }
        if (zid == ZONE_LANTERNFALL) { return ZONE_KELP_FOREST; }
        if (zid == ZONE_KELP_FOREST) {
            if (lvl >= 17 || spent > 300) { return ZONE_PRESSURE_COURT; }
            return -1;
        }
        if (zid == ZONE_PRESSURE_COURT) {
            if (lvl >= 19 || spent > 300) { return ZONE_THE_UNDERTOW; }
            return -1;
        }
        if (zid == ZONE_THE_UNDERTOW) { return -1; }
        if (zid == ZONE_CHARTED_SHALLOWS) {
            if (map_t > 5000) { return ZONE_SALTMERE; }
            return -1;
        }
        return 0;
    }
    // The endgame, both acts down. A map run lasts ~8 minutes, then home
    // to the NEAREST Map Device (Lanternfall keeps one too); dry, the road
    // leads to the Sovereign — the deepest act boss pays the deepest
    // maps.
    if (zid == ZONE_CHARTED_SHALLOWS) {
        // HOME IS WHERE THE EXIT GOES (#162 live find): the route said
        // Lanternfall but the map run's only exit lands in SALTMERE — want
        // never matched an exit and two brains farmed one tier-1 map run
        // for two hours. Saltmere keeps a device; the cycle closes there.
        if (map_t > 5000) { return ZONE_SALTMERE; }
        return -1;
    }
    if (find_map() >= 0) {
        if (zid == ZONE_LANTERNFALL) { return -1; }  // the device logic in main
        if (zid == ZONE_SALTMERE) { return -1; }
        if (zid == ZONE_THE_UNDERTOW) { return ZONE_PRESSURE_COURT; }
        if (zid == ZONE_PRESSURE_COURT) { return ZONE_KELP_FOREST; }
        if (zid == ZONE_KELP_FOREST) { return ZONE_LANTERNFALL; }
        if (zid == ZONE_SUNKEN_STAIR) { return ZONE_LANTERNFALL; }
        if (zid == ZONE_HOLLOW) { return ZONE_SUNKEN_STAIR; }
        if (zid == ZONE_SALTWORKS) { return ZONE_HOLLOW; }
        if (zid == ZONE_COAST) { return ZONE_SALTWORKS; }
        return -1;
    }
    if (zid == ZONE_LANTERNFALL) { return ZONE_KELP_FOREST; }
    if (zid == ZONE_KELP_FOREST) { return ZONE_PRESSURE_COURT; }
    if (zid == ZONE_PRESSURE_COURT) { return ZONE_THE_UNDERTOW; }
    if (zid == ZONE_THE_UNDERTOW) { return -1; }
    if (zid == ZONE_SALTMERE) { return ZONE_COAST; }
    if (zid == ZONE_COAST) { return ZONE_SALTWORKS; }
    if (zid == ZONE_SALTWORKS) { return ZONE_HOLLOW; }
    if (zid == ZONE_HOLLOW) { return ZONE_SUNKEN_STAIR; }
    if (zid == ZONE_SUNKEN_STAIR) { return ZONE_LANTERNFALL; }
    return 0;
}

fn main() {
    self_status(SELF);
    if (mem[SELF + SS_FLAGS] & 1) { was_dead = 1; return; }        // dead: wait for respawn
    // DEATH-SHYNESS (post-playtest quality pass): the first thing a
    // respawner used to do was charge its own killers — the pack that
    // chased it to the spawn is still there, and the loop was 700+
    // deaths on surveyed seeds. For ~15s after a respawn the brain
    // will not ENGAGE (loot, travel, and wandering proceed; the
    // killers leash home meanwhile; the engine's respawn grace keeps
    // them from re-locking us first).
    if (was_dead == 1) {
        was_dead = 0;
        shy = 150;
    }
    if (shy > 0) { shy = shy - 1; }

    // Crossed into a new zone: fresh intent. Grind what it feeds us;
    // departures must be EARNED by boredom again.
    var zid = mem[SELF + SS_ZONE];
    if (zid != last_zone) {
        last_zone = zid;
        bored = 0;
        leaving = 0;
        map_t = 0;
    }
    if (zid == ZONE_CHARTED_SHALLOWS) { map_t = map_t + 1; }

    // A word when the shore concedes a level (speech.ron line 2).
    var lvl = mem[SELF + SS_LEVEL];
    if (last_level == 0) { last_level = lvl; }
    if (lvl > last_level) {
        last_level = lvl;
        say(2);
    }

    // Below 40% life: drink. The flask is the survival lesson.
    if (mem[SELF + SS_LIFE] * 5 < mem[SELF + SS_LIFE_MAX] * 2) {
        use_flask();
    }

    // Loot: claim what's underfoot now; remember what's distant. If
    // nothing needs fighting we WALK to it — drops despawn, and some
    // (the witch's support gem) are literally gate keys.
    var loot_x = 0;
    var loot_y = 0;
    var have_loot = 0;
    // Shed loot is OUR loot — the F_LOOT query hands discards right back
    // (a 34-record bag proved the cycle). Look away while the tide takes.
    if (shed_cd > 0) { shed_cd = shed_cd - 1; }
    if (shed_cd <= 0 && read_entities(ENTS, 4, F_LOOT) > 0) {
        if (pick_up(mem[ENTS]) != 0) {
            have_loot = 1;
            loot_x = mem[ENTS + 8];
            loot_y = mem[ENTS + 12];
        }
    }

    // Upkeep (#54 PR3): selection lives in the BOT now, not the engine autos.
    // Gear: wear our own upgrades. Gems: socket ONLY melee skills + their
    // supports — a bow gem (power_shot) or a spell is never in the plan, so it's
    // never socketed (the weapon-compat skip #52 wanted). Passives self-allocate
    // per the declared build.
    // BUDGET DISCIPLINE (#136 T6): upkeep — a 12-slot gear read, a full
    // bag scan, and seven socket probes — is the tick's biggest spender,
    // and gear doesn't change mid-swing. It all fires on ONE tick in ten
    // (shed + gear + sockets together), then rests nine; the campaign
    // brain (route/device/exits) bought its budget here.
    if (upkeep_in <= 0) {
        upkeep_in = 10;
        shed_trash();
        upkeep_gear();
    }
    upkeep_in = upkeep_in - 1;
    if (upkeep_in == 9) {
    // First Spark (NODE_START) is a socket allocated from level 1; the deep
    // limb sockets (HUNT/GALE) unlock much later. The shore pays a bow build
    // POWER SHOT (the declared-arch payment) and the witch adds a support —
    // the skill must land at START before any support can join it. Each call
    // is idempotent (a filled node or absent gem returns -1).
    socket_into(NODE_START, GEM_POWER_SHOT);
    socket_into(NODE_START, GEM_SPLIT_QUIVER);
    socket_into(NODE_START, GEM_QUICKENING);
    socket_into(NODE_SOCKET_HUNT, GEM_POWER_SHOT);
    socket_into(NODE_SOCKET_HUNT, GEM_SPLIT_QUIVER);
    socket_into(NODE_SOCKET_GALE, GEM_QUICKENING);
    }

    // THE MAP DEVICE (#136 T6): in town, after the act, holding a map —
    // walk to the Map Device and head. OpenMap refuses harmlessly
    // (-2) until we're in reach; keep walking until it takes.
    // The CAMPAIGN OUTRANKS the maps (#148 A3): a mid-campaign pupil
    // carrying the Mother's map once opened from Lanternfall's device the
    // moment it arrived, abandoning Act 2 — the device waits until no act
    // is pending (flags bit 2 = act 2, the current last; revisit per act).
    if (zid == ZONE_SALTMERE || zid == ZONE_LANTERNFALL) {
        if ((mem[SELF + SS_FLAGS] & 4) != 0) {
            var map = find_map();
            if (map >= 0) {
                // JUNK BECOMES OBOLS first (#148 A5): everything upkeep
                // left loose is a loser by definition — maps and build
                // gems excepted (the shed rule, monetized). One sale per
                // tick at the vendor, then the device.
                var vx = mem[SELF + SS_VENDOR_X];
                if (vx >= 0) {
                    var sn = read_inventory(INV, 60);
                    var si = 0;
                    var junk = -1;
                    while (si < sn) {
                        var srec = INV + si * INVENTORY_RECORD_SIZE;
                        var snum = mem[srec];
                        if (snum != ITEM_SALT_STAINED_CHART) {
                            if (item_slot(snum) >= 0) { junk = si; }
                        }
                        si = si + 1;
                    }
                    if (junk >= 0) {
                        // Sell only on the tick upkeep just ran (== 9):
                        // equip_best has always seen a fresh drop before
                        // the vendor can — a returned WINNER is worn, not
                        // sold.
                        if (upkeep_in == 9) {
                            if (sell(junk) > 0) { return; }
                        }
                        move_to(vx, mem[SELF + SS_VENDOR_Y]);
                        return;
                    }
                }
                var tbx = mem[SELF + SS_TABLE_X];
                if (tbx >= 0) {
                    if (open_map(map) == 0) { return; }
                    move_to(tbx, mem[SELF + SS_TABLE_Y]);
                    return;
                }
            }
        }
    }

    // Find the exit the ROAD wants (#136 T6). A routed destination IS the
    // commitment: the level gates in route_dest decide when a zone is done
    // (boredom can't — a map is private and finite; the clock is the exit).
    var open_ex = 0;
    var ex = 0;
    var ey = 0;
    var want = route_dest();
    if (want > 0) {
        leaving = 1;
        var nxits = read_exits(EXITS, 4);
        var e = 0;
        while (e < nxits) {
            var er = EXITS + e * EXIT_RECORD_SIZE;
            if (mem[er + 8] == 1 && mem[er + 12] == want) {
                open_ex = 1;
                ex = mem[er];
                ey = mem[er + 4];
                e = nxits;
            }
            e = e + 1;
        }
    }
    // Off the road (a zone the route doesn't know), BOREDOM stays the
    // escape valve: ~12s with nothing to fight commits us to the first
    // open exit — no zone may strand a stock bot.
    if (want == 0 && leaving == 1) {
        var nx2 = read_exits(EXITS, 4);
        var e2 = 0;
        while (e2 < nx2) {
            var er2 = EXITS + e2 * EXIT_RECORD_SIZE;
            if (mem[er2 + 8] == 1) {
                open_ex = 1;
                ex = mem[er2];
                ey = mem[er2 + 4];
                e2 = nx2;
            }
            e2 = e2 + 1;
        }
    }

    // Fight the nearest enemy we can SEE. The query returns enemies
    // through walls, and steering has no pathfinding — chasing a target
    // behind rock pins the bot against the cliff forever (the Tidewarden
    // arena wall taught us this). Sight ≈ path on tile maps; an enemy
    // without line_of_sight is not our fight yet.
    var nen = read_entities(ENTS, 8, F_ENEMY);
    // Death-shy: no engagement while the timer runs (the world's other
    // verbs — loot, travel, wander — all still fire below).
    if (shy > 0) { nen = 0; }
    var target = -1;
    var tx = 0;
    var ty = 0;
    var trarity = 0;
    var k = 0;
    while (k < nen) {
        var cand = ENTS + k * ENTITY_RECORD_SIZE;
        if (line_of_sight(mem[cand + 8], mem[cand + 12]) == 1) {
            target = mem[cand];
            tx = mem[cand + 8];
            ty = mem[cand + 12];
            trarity = mem[cand + 20];
            k = nen;
        }
        k = k + 1;
    }

    // UNSTICK: sight is not always path. A target visible through a
    // crack in a cliff pins us against it forever (we see it, so we
    // chase; we chase, so we never get bored). If we hold a target
    // BEYOND attack reach and barely move for 3 seconds, geometry is
    // beating us — drop the target and wander hard for a few seconds
    // to round the obstacle.
    if (unstick > 0) {
        unstick = unstick - 1;
        target = -1;
    }
    var intent = 0;
    if (target >= 0) { intent = 1; }
    if (open_ex == 1 && leaving == 1 && unstick <= 0) { intent = 1; }
    if (intent == 1) {
        stuck_t = stuck_t + 1;
        if (stuck_t >= 30) {
            var sdx = mem[SELF] - stuck_x;
            if (sdx < 0) { sdx = 0 - sdx; }
            var sdy = mem[SELF + SS_Y] - stuck_y;
            if (sdy < 0) { sdy = 0 - sdy; }
            if (sdx < 0x8000 && sdy < 0x8000) {
                // Within attack reach of a TARGET we WANT to stand still
                // (we're swinging); beyond it — or parked on the way to an
                // exit — parked means pinned.
                var pinned = 1;
                if (target >= 0) {
                    var reach = mem[SELF + SS_ATTACK_RANGE] + 0x18000;
                    var tdx = tx - mem[SELF];
                    if (tdx < 0) { tdx = 0 - tdx; }
                    var tdy = ty - mem[SELF + SS_Y];
                    if (tdy < 0) { tdy = 0 - tdy; }
                    if (tdx <= reach && tdy <= reach) { pinned = 0; }
                }
                if (pinned == 1) {
                    unstick = 40;
                    wander_left = 0; // pick a fresh stroll target now
                    target = -1;
                }
            }
            stuck_x = mem[SELF];
            stuck_y = mem[SELF + SS_Y];
            stuck_t = 0;
        }
    }
    if (intent == 0) { stuck_t = 0; }

    // Only VISIBLE enemies hold our interest; mobs behind walls don't
    // stop the boredom clock (wandering will reveal them, or not).
    if (target >= 0) {
        if (leaving == 0) { bored = 0; }
    }
    if (target < 0) { bored = bored + 1; }
    if (bored > 120) { leaving = 1; }

    if (target >= 0) {
        spent = 0; // a VISIBLE enemy means the zone still pays (reset
                   // BEFORE the heading-out branch can return — codex)
        // Heading out? Ignore enemies beyond ~6u (Chebyshev, raw Q16.16:
        // squaring raw deltas would overflow).
        if (open_ex == 1 && leaving == 1) {
            var adx = tx - mem[SELF];
            if (adx < 0) { adx = 0 - adx; }
            var ady = ty - mem[SELF + SS_Y];
            if (ady < 0) { ady = 0 - ady; }
            // Only a bodily BLOCKER (enemies body-block; ~1.8u) stops a
            // departing bot — the old 6u radius let a dense court chain
            // approach-fights forever at the gate (#148 A2: a level-19
            // ranger farmed a thousand kills eight rows from the exit).
            if (adx > 0x1CCCC || ady > 0x1CCCC) {
                // The wanted-door guard applies here too (#162 Mirra).
                var fxd = mem[SELF] - ex;
                if (fxd < 0) { fxd = 0 - fxd; }
                var fyd = mem[SELF + SS_Y] - ey;
                if (fyd < 0) { fyd = 0 - fyd; }
                if (fxd < 65536 && fyd < 65536) {
                    if (use_exit() == 0) { return; }
                }
                move_to(ex, ey);
                return;
            }
        }
        // Mana budget: gem skills only above 20% mana — the basic
        // attack is free, and the pool wants emergency headroom.
        var used = -1;
        if (mem[SELF + SS_MANA] * 5 >= mem[SELF + SS_MANA_MAX]) {
            // First READY skill wins (record +32; ready already folds
            // cooldown, mana, use-time, and the weapon gate).
            var n = read_skills(SKL, 4);
            var i = 0;
            while (i < n) {
                var rec = SKL + i * SKILL_RECORD_SIZE;
                if (mem[rec + 32] == 1) {
                    used = fire_skill(rec, i + 1, target, tx, ty);
                    if (used == 0) { i = n; }
                }
                i = i + 1;
            }
        }
        if (used != 0) {
            use_skill(0, target, 0, 0);
        }
        // XP-DROUGHT (#148 A2.5): the ONE robust futility signal. Chip-and-
        // regen targets yo-yo their life; two milling rares alternate as
        // "nearest" and reset every per-target audit (a coast pair held a
        // caster on one cell for 60k ticks). Earnings can't be gamed:
        // fifteen seconds fighting without XP = this fight pays nothing.
        // First drought buys a STRAFE (corner-clips break sideways); a
        // second in a row abandons the spot entirely.
        var xp_now = mem[SELF + SS_XP];
        if (xp_now > last_xp) {
            drought = 0;
            strafed = 0;
        }
        last_xp = xp_now;
        // BOSSES ARE EXEMPT: a unique pays all its XP at the end — a long
        // boss fight IS a drought until the kill (the detector once walked
        // the grinder out of Karesh's court mid-fight).
        if (trarity < 3) { drought = drought + 1; }
        if (trarity >= 3) { drought = 0; }
        if (drought > 150) {
            drought = 0;
            if (strafed == 0) {
                strafed = 1;
                close_in = 60;
            }
            if (strafed == 1 && close_in <= 0) {
                strafed = 0;
                unstick = 80;
            }
        }
        if (close_in > 0) { close_in = close_in - 1; }
        // RANGED HOLD (#148 A2): the weapon's whole point is the gap.
        // Inside ~70% of attack range, stand and cast; outside, close in.
        // EXCEPT while the road calls (leaving) or the gap audit says the
        // shots aren't landing: holding ground at the court's mouth farmed
        // a thousand approaches without ever taking the eight rows to the
        // exit — a departing ranged bot walks THROUGH its fights.
        if (leaving == 1) {
            move_to(tx, ty);
            return;
        }
        if (close_in > 0) {
            // STRAFE, not charge (#148 A2): a corner-clip breaks by moving
            // SIDEWAYS at range — walking into the arms of what out-trades
            // us was 123 hollow deaths on one run.
            move_to(tx + (mem[SELF + SS_Y] - ty), ty + (mem[SELF] - tx));
            return;
        }
        var hdx = tx - mem[SELF];
        if (hdx < 0) { hdx = 0 - hdx; }
        var hdy = ty - mem[SELF + SS_Y];
        if (hdy < 0) { hdy = 0 - hdy; }
        // NINE tenths, not seven (#148 A2.5): at 70% a bow held INSIDE
        // the Mother's arc envelope and traded a 500-life pool against her
        // 2000 — the weapon's whole identity is out-ranging the answer.
        var hold = (mem[SELF + SS_ATTACK_RANGE] * 9) / 10;
        if (hdx > hold || hdy > hold) {
            move_to(tx, ty);
        }
        return;
    }

    spent = spent + 1;
    // Nothing to fight: collect outstanding loot first (it expires),
    // then leave only once boredom commits us (the bot's own call —
    // nothing forces a transfer), else EXPLORE: hold a wander target
    // for a few seconds instead of re-rolling every tick, so an idle
    // bot strolls the map like it lives there (towns especially —
    // SelfStatus +64 carries the zone's stable tagged num when a brain
    // wants zone-specific behavior).
    if (have_loot == 1) {
        move_to(loot_x, loot_y);
        return;
    }
    if (open_ex == 1 && leaving == 1) {
        // Only the WANTED door (#162 Mirra): use_exit() consumes whatever
        // exit is UNDERFOOT — the Pressure Court's respawn sits beside its
        // south exit, so a dying bot heading NORTH kept eating the south
        // door and commuting backward (the 191-death loop). Fire only
        // within a cell of the exit the route chose.
        var exd = mem[SELF] - ex;
        if (exd < 0) { exd = 0 - exd; }
        var eyd = mem[SELF + SS_Y] - ey;
        if (eyd < 0) { eyd = 0 - eyd; }
        if (exd < 65536 && eyd < 65536) {
            if (use_exit() == 0) { return; }
        }
        move_to(ex, ey);
        return;
    }
    if (wander_left <= 0) {
        wander_x = (random() & 0x7FFFFFFF) % mem[SELF + SS_MAP_W];
        // THE ROAD RUNS NORTH (#148 A2): every zone in this game enters
        // from the south and keeps its goal at the top of the map — the
        // authoring convention since the shore. Three strolls in four aim
        // at-or-north of where we stand (progress is the default, so
        // choreography waiting down-strand — the witch, the basin — gets
        // met even when nothing chases us there); the fourth sweeps
        // anywhere, so terrace pockets behind us are re-found. Replaces
        // the Hollow-only deep bias (this seed-hunted a 1.0 tutorial
        // deadlock: a pupil parked at y=60 forever, one row shy of the
        // witch's y<60 spawn trigger).
        var yn = mem[SELF + SS_Y] / 65536;
        wander_y = (random() & 0x7FFFFFFF) % (yn + 1);
        if ((random() & 3) == 0) {
            wander_y = (random() & 0x7FFFFFFF) % mem[SELF + SS_MAP_H];
        }
        // ESCAPES NEED FREEDOM: while unsticking, the progress bias is the
        // enemy — at the top of a map every "north-of-here" target IS the
        // corner we're pinned in (the slide walked a pupil into the coast's
        // top corner and the bias held it there).
        if (unstick > 0) {
            wander_y = (random() & 0x7FFFFFFF) % mem[SELF + SS_MAP_H];
        }
        wander_left = 50 + ((random() & 0x7FFFFFFF) % 70);
    }
    wander_left = wander_left - 1;
    move_to(wander_x, wander_y);
}
