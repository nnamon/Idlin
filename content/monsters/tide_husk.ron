// A bloated hulk of brine and sinew. Hits like a pier collapsing.
MonsterDef(
    id: "tide_husk",
    public: true,
    name: "Tide Husk",
    model: "husk",
    brain: "hostile_melee",
    hostile: true,
    level: 3,
    life: 90,
    damage: 6,
    speed_cps: 195,
    radius_cu: 80,
    range_cu: 220,
    mana: 40,
    skills: [
        (gem: "arc", level: 2),
    ],
    // A fixed passive kit (#125, full monster parity) — same Grant vocabulary as the
    // player tree, folded into the husk's derived stats every refresh. Bloated bulk +
    // a strike-time ENRAGE: it hits harder once it's been wounded past half life
    // (a monster strike-time condition, the mirror of `of_desperation`).
    passives: [
        (stat: life, layer: increased, value: 5000),    // +50% life (bloated)
        (stat: armour, layer: added, value: 60),         // thicker hide
        (stat: damage_phys, layer: increased, value: 4000, condition: Some(below_life_pct(5000))),
    ],
    use_ticks: 16,
    aggro_radius_cu: 1300,
    armour: 80,
    resist_cold: 2500,
    xp: 70,
    projectile: false,
)
