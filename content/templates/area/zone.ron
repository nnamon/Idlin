// TEMPLATE — copy content/templates/area/ to content/areas/<your_area>/
// and fill in. The loader ignores templates/ entirely.
//
// An area bundle is everything one area needs, packaged together:
//   areas/<name>/zone.ron        this file
//   areas/<name>/brain.bot       the area's script (brain id = <name>)
//   areas/<name>/monsters/*.ron  area-exclusive monsters
ZoneDef(
    id: "my_area",              // the lookup key (unique)
    name: "My Area",
    kind: story,                // story | map | town (death rules)
    width_u: 40,
    height_u: 100,
    spawn_x_u: 20,              // where idlers enter (and respawn, in
    spawn_y_u: 92,              // story zones)
    spawn_radius_u: 6,
    camp_radius_u: 10,          // sanctuary: monsters never acquire
                                // characters inside this (0 = none)
    gen_rocks: 12,
    gen_trees: 6,
    brain: Some("my_area"),     // = this area's directory name
    lines: [
        // Narration the brain fires by index. Text lives HERE; the
        // script only decides when and to whom.
        "You arrive.",
    ],
    packs: [
        // radius_u: 0 stakes the spawn exactly on the anchor (scripted
        // prey, bosses). Packs respawn as a unit.
        SpawnPack(monster: "drowned_shambler", count: 1, x_u: 20, y_u: 84, radius_u: 0, respawn_ticks: 300),
    ],
)
