// Campaign zone 1: a long drowned strand. Idlers wash up at the south
// end and fight their way north along the waterline; packs grow nastier
// the further up the shore they push. (Tutorial strip — will become a
// per-idler instance once zone instancing lands.)
ZoneDef(
    id: "withered_shore",
    name: "The Withered Shore",
    width_u: 34,
    height_u: 130,
    spawn_x_u: 17,
    spawn_y_u: 122,
    spawn_radius_u: 7,
    gen_rocks: 16,
    gen_trees: 9,
    // Scripted onboarding: every idler's first kill yields a weapon, the
    // second a skill gem that suits it.
    tutorial_drops: true,
    // Packs spawn (and respawn) as a unit: survivors hold their ground
    // until the whole pack is wiped, then the timer brings it back.
    packs: [
        SpawnPack(monster: "drowned_shambler", count: 6, x_u: 16, y_u: 108, radius_u: 5, respawn_ticks: 400),
        SpawnPack(monster: "drowned_shambler", count: 7, x_u: 22, y_u: 94,  radius_u: 5, respawn_ticks: 400),
        SpawnPack(monster: "drowned_shambler", count: 6, x_u: 10, y_u: 80,  radius_u: 4, respawn_ticks: 400),
        SpawnPack(monster: "drowned_shambler", count: 7, x_u: 18, y_u: 66,  radius_u: 5, respawn_ticks: 400),
        SpawnPack(monster: "bone_stalker",     count: 4, x_u: 24, y_u: 53,  radius_u: 5, respawn_ticks: 500),
        SpawnPack(monster: "bone_stalker",     count: 5, x_u: 12, y_u: 40,  radius_u: 6, respawn_ticks: 500),
        SpawnPack(monster: "tide_husk",        count: 3, x_u: 20, y_u: 27,  radius_u: 4, respawn_ticks: 700),
        SpawnPack(monster: "bone_stalker",     count: 4, x_u: 10, y_u: 17,  radius_u: 5, respawn_ticks: 500),
        SpawnPack(monster: "tide_husk",        count: 4, x_u: 17, y_u: 9,   radius_u: 4, respawn_ticks: 700),
    ],
)
