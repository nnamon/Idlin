// The SHORE tileset: wave-battered strands, tide pools, dead coastal
// scrub. The Withered Shore is its first zone; later coastal maps reuse
// the same kit under variants. natural_monsters is the tileset's native
// ecology — zones stage specials (the Tidewarden) on top.
TilesetDef(
    id: "shore",
    tiles: [
        (glyph: '.', id: "sand",  walkable: true,  blocks_los: false, ground: "sand"),
        (glyph: ',', id: "scrub", walkable: true,  blocks_los: false, ground: "grass"),
        (glyph: 'g', id: "tuft",  walkable: true,  blocks_los: false, ground: "sand", prop: Some("tuft")),
        (glyph: '~', id: "sea",   walkable: false, blocks_los: false, ground: "water"),
        (glyph: 'R', id: "rock",  walkable: false, blocks_los: true,  ground: "sand", prop: Some("rock")),
        (glyph: 'T', id: "tree",  walkable: false, blocks_los: true,  ground: "grass", prop: Some("dead_tree")),
        // The UPPER level: terraces one full step above the strand. Level
        // edges are authored with crag tiles (the cliff lip); ramps are
        // simply gaps in the crag line where the slope shows.
        (glyph: '^', id: "terrace",       walkable: true,  blocks_los: false, ground: "sand",  elevation: 1),
        (glyph: ';', id: "terrace_scrub", walkable: true,  blocks_los: false, ground: "grass", elevation: 1),
        (glyph: 'h', id: "terrace_tuft",  walkable: true,  blocks_los: false, ground: "sand",  prop: Some("tuft"), elevation: 1),
        (glyph: 'K', id: "crag",          walkable: false, blocks_los: true,  ground: "sand",  prop: Some("rock"), elevation: 1),
    ],
    palette: [
        ("sand",  "#4e4a44"),
        ("grass", "#36413a"),
        ("water", "#13233a"),
    ],
    variants: [
        // The same strand at a colder, darker hour (later maps).
        (id: "drowned", palette: [("sand", "#3e4046"), ("water", "#0e1c30")]),
    ],
    natural_monsters: ["drowned_shambler", "bone_stalker", "tide_husk"],
    // The strand's look, OPT-IN: variants of this family compose from these.
    features: ["sea", "bluffs_west", "edge_hills", "stars", "fringe_scatter"],
)
