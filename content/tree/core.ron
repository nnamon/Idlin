// The shared passive tree. Everyone (classless) starts at `start`; nodes
// grant affixes exactly like gear. Socket nodes hold gems: socket_skill =
// an active skill slot, adjacent socket_support nodes modify that skill.
//
// Layout (pos is abstract client units):
//                 EMBERS (elemental/chaos)
//                        |
//   SLAUGHTER (phys) — START — ZEPHYR (speed/evasion)
//                        |
//                 VITALITY (life/armour)
//
// Branch shape: 3 travels → notable → 3 travels → notable → keystone/rim.
// Values: travels small, notables chunky, keystones trade-offs (more-layer).
TreeDef(
    nodes: [
        NodeDef(id: "start", num: 1, name: "Awakening", pos: (0, 0), kind: travel,
                links: ["s1", "v1", "z1", "e1", "socket_a"], grants: []),

        // --- the first socket cluster, right at the start ---
        NodeDef(id: "socket_a", num: 2, name: "First Spark", pos: (2, 2), kind: socket_skill,
                grants: []),
        NodeDef(id: "socket_a1", num: 3, name: "First Spark Support", pos: (4, 3), kind: socket_support,
                links: ["socket_a"], grants: []),

        // ===================== SLAUGHTER (west): physical =====================
        NodeDef(id: "s1", num: 10, name: "Brawn", pos: (-3, 0), kind: travel,
                grants: [(stat: damage_phys, layer: added, value: 3)]),
        NodeDef(id: "s2", num: 11, name: "Heft", pos: (-6, 0), kind: travel, links: ["s1"],
                grants: [(stat: damage_phys, layer: increased, value: 800)]),
        NodeDef(id: "s3", num: 12, name: "Cleaving Steps", pos: (-9, 0), kind: travel, links: ["s2"],
                grants: [
                    (stat: damage_phys, layer: increased, value: 500),
                    (stat: accuracy, layer: added, value: 10),
                ]),
        NodeDef(id: "s4", num: 13, name: "Butcher", pos: (-12, 0), kind: notable, links: ["s3"],
                grants: [
                    (stat: damage_phys, layer: increased, value: 1800),
                    (stat: life, layer: added, value: 15),
                ]),
        NodeDef(id: "s5", num: 14, name: "Sure Hands", pos: (-15, 0), kind: travel, links: ["s4"],
                grants: [(stat: accuracy, layer: added, value: 25)]),
        NodeDef(id: "s6", num: 15, name: "Brutal Rhythm", pos: (-18, 0), kind: travel, links: ["s5"],
                grants: [(stat: attack_speed, layer: increased, value: 600)]),
        NodeDef(id: "s7", num: 16, name: "Executioner", pos: (-21, 0), kind: notable, links: ["s6"],
                grants: [
                    (stat: damage_phys, layer: increased, value: 2500),
                    (stat: attack_speed, layer: increased, value: 500),
                ]),
        NodeDef(id: "s8", num: 17, name: "Overwhelm", pos: (-24, 0), kind: travel, links: ["s7"],
                grants: [(stat: damage_phys, layer: increased, value: 1000)]),
        NodeDef(id: "s9", num: 18, name: "Juggernaut", pos: (-27, 0), kind: keystone, links: ["s8"],
                grants: [
                    (stat: armour, layer: more, value: 4000),        // 40% MORE armour
                    (stat: attack_speed, layer: more, value: -1000), // 10% LESS attack speed
                ]),
        // war socket cluster off Butcher
        NodeDef(id: "socket_war", num: 19, name: "War Socket", pos: (-12, -3), kind: socket_skill,
                links: ["s4"], grants: []),
        NodeDef(id: "socket_war_a", num: 20, name: "War Support I", pos: (-14, -5), kind: socket_support,
                links: ["socket_war"], grants: []),
        NodeDef(id: "socket_war_b", num: 21, name: "War Support II", pos: (-10, -5), kind: socket_support,
                links: ["socket_war_a"], grants: []),

        // ===================== VITALITY (south): life/armour ==================
        NodeDef(id: "v1", num: 30, name: "Vigor", pos: (0, 3), kind: travel,
                grants: [(stat: life, layer: added, value: 12)]),
        NodeDef(id: "v2", num: 31, name: "Thick Skin", pos: (0, 6), kind: travel, links: ["v1"],
                grants: [(stat: armour, layer: added, value: 25)]),
        NodeDef(id: "v3", num: 32, name: "Hardy", pos: (0, 9), kind: travel, links: ["v2"],
                grants: [(stat: life, layer: increased, value: 800)]),
        NodeDef(id: "v4", num: 33, name: "Oak Heart", pos: (0, 12), kind: notable, links: ["v3"],
                grants: [
                    (stat: life, layer: increased, value: 1200),
                    (stat: life, layer: added, value: 10),
                ]),
        NodeDef(id: "v5", num: 34, name: "Bulwark", pos: (0, 15), kind: travel, links: ["v4"],
                grants: [(stat: armour, layer: added, value: 40)]),
        NodeDef(id: "v6", num: 35, name: "Stalwart", pos: (0, 18), kind: travel, links: ["v5"],
                grants: [(stat: armour, layer: increased, value: 800)]),
        NodeDef(id: "v7", num: 36, name: "Colossus", pos: (0, 21), kind: notable, links: ["v6"],
                grants: [
                    (stat: armour, layer: increased, value: 2000),
                    (stat: life, layer: added, value: 20),
                ]),
        NodeDef(id: "v8", num: 37, name: "Iron Will", pos: (0, 24), kind: travel, links: ["v7"],
                grants: [(stat: life, layer: added, value: 15)]),
        // root socket cluster off Oak Heart
        NodeDef(id: "socket_root", num: 38, name: "Root Socket", pos: (3, 12), kind: socket_skill,
                links: ["v4"], grants: []),
        NodeDef(id: "socket_root_a", num: 39, name: "Root Support", pos: (5, 14), kind: socket_support,
                links: ["socket_root"], grants: []),

        // ===================== ZEPHYR (east): speed/evasion ===================
        NodeDef(id: "z1", num: 50, name: "Poise", pos: (3, 0), kind: travel,
                grants: [(stat: evasion, layer: added, value: 18)]),
        NodeDef(id: "z2", num: 51, name: "Fleet", pos: (6, 0), kind: travel, links: ["z1"],
                grants: [(stat: move_speed, layer: increased, value: 600)]),
        NodeDef(id: "z3", num: 52, name: "Tempo", pos: (9, 0), kind: travel, links: ["z2"],
                grants: [(stat: attack_speed, layer: increased, value: 600)]),
        NodeDef(id: "z4", num: 53, name: "Windrunner", pos: (12, 0), kind: notable, links: ["z3"],
                grants: [
                    (stat: move_speed, layer: increased, value: 1000),
                    (stat: attack_speed, layer: increased, value: 800),
                ]),
        NodeDef(id: "z5", num: 54, name: "Slippery", pos: (15, 0), kind: travel, links: ["z4"],
                grants: [(stat: evasion, layer: added, value: 30)]),
        NodeDef(id: "z6", num: 55, name: "Dancer", pos: (18, 0), kind: travel, links: ["z5"],
                grants: [(stat: evasion, layer: increased, value: 800)]),
        NodeDef(id: "z7", num: 56, name: "Ghoststep", pos: (21, 0), kind: notable, links: ["z6"],
                grants: [
                    (stat: evasion, layer: increased, value: 2000),
                    (stat: move_speed, layer: increased, value: 500),
                ]),
        NodeDef(id: "z8", num: 57, name: "Phantom Grace", pos: (24, 0), kind: keystone, links: ["z7"],
                grants: [
                    (stat: evasion, layer: more, value: 3500), // 35% MORE evasion
                    (stat: life, layer: more, value: -1200),   // 12% LESS life
                ]),
        // wind socket cluster off Windrunner
        NodeDef(id: "socket_wind", num: 58, name: "Wind Socket", pos: (12, -3), kind: socket_skill,
                links: ["z4"], grants: []),
        NodeDef(id: "socket_wind_a", num: 59, name: "Wind Support", pos: (14, -5), kind: socket_support,
                links: ["socket_wind"], grants: []),

        // ===================== EMBERS (north): elemental/chaos ================
        NodeDef(id: "e1", num: 70, name: "Spark", pos: (0, -3), kind: travel,
                grants: [(stat: damage_ele, layer: added, value: 2)]),
        NodeDef(id: "e2", num: 71, name: "Kindle", pos: (0, -6), kind: travel, links: ["e1"],
                grants: [(stat: damage_ele, layer: increased, value: 1000)]),
        NodeDef(id: "e3", num: 72, name: "Soot-Veined", pos: (0, -9), kind: travel, links: ["e2"],
                grants: [(stat: resist_ele, layer: added, value: 800)]),
        NodeDef(id: "e4", num: 73, name: "Emberheart", pos: (0, -12), kind: notable, links: ["e3"],
                grants: [
                    (stat: damage_ele, layer: increased, value: 2000),
                    (stat: damage_ele, layer: added, value: 3),
                ]),
        NodeDef(id: "e5", num: 74, name: "Venom", pos: (0, -15), kind: travel, links: ["e4"],
                grants: [(stat: damage_chaos, layer: added, value: 2)]),
        NodeDef(id: "e6", num: 75, name: "Fester", pos: (0, -18), kind: travel, links: ["e5"],
                grants: [(stat: damage_chaos, layer: increased, value: 1200)]),
        NodeDef(id: "e7", num: 76, name: "Plagueborn", pos: (0, -21), kind: notable, links: ["e6"],
                grants: [
                    (stat: damage_chaos, layer: increased, value: 2000),
                    (stat: resist_chaos, layer: added, value: 1000),
                ]),
        NodeDef(id: "e8", num: 77, name: "Attunement", pos: (0, -24), kind: travel, links: ["e7"],
                grants: [(stat: resist_ele, layer: added, value: 1000)]),
        // flame socket cluster off Emberheart
        NodeDef(id: "socket_flame", num: 78, name: "Flame Socket", pos: (3, -12), kind: socket_skill,
                links: ["e4"], grants: []),
        NodeDef(id: "socket_flame_a", num: 79, name: "Flame Support I", pos: (5, -14), kind: socket_support,
                links: ["socket_flame"], grants: []),
        NodeDef(id: "socket_flame_b", num: 80, name: "Flame Support II", pos: (7, -12), kind: socket_support,
                links: ["socket_flame_a"], grants: []),

        // ===================== the rim: cross-branch travel ===================
        NodeDef(id: "grit", num: 90, name: "Grit", pos: (-14, 14), kind: travel,
                links: ["s7", "v7"],
                grants: [
                    (stat: life, layer: added, value: 8),
                    (stat: damage_phys, layer: increased, value: 400),
                ]),
        NodeDef(id: "surefoot", num: 91, name: "Surefoot", pos: (14, 14), kind: travel,
                links: ["v7", "z7"],
                grants: [
                    (stat: evasion, layer: added, value: 10),
                    (stat: life, layer: added, value: 8),
                ]),
        NodeDef(id: "stormdance", num: 92, name: "Stormdance", pos: (14, -14), kind: travel,
                links: ["z7", "e7"],
                grants: [
                    (stat: attack_speed, layer: increased, value: 400),
                    (stat: damage_ele, layer: added, value: 2),
                ]),
        NodeDef(id: "scorched_edge", num: 93, name: "Scorched Edge", pos: (-14, -14), kind: travel,
                links: ["e7", "s7"],
                grants: [
                    (stat: damage_phys, layer: added, value: 2),
                    (stat: damage_ele, layer: added, value: 2),
                ]),
    ],
)
