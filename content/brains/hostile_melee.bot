// Hostile NPC brain: leash to home, chase and attack the nearest
// enemy within aggro range, wander when idle. If the def gave us a
// skill kit, lead with slot 1 in its own targeting mode; the basic
// attack is the fallback.
//
// NPCs run the exact same VM and syscalls as player bots —
// behavior is content, not engine code. ReadEntities filter 1 is
// "enemies of me", so this brain hunts players automatically.

const SELF = 0xE000;
const ENTS = 0xE100;
const SKL = 0xE400;        // ReadSkills records (40 bytes each)
const F_ENEMY = 1;
const LEASH = 0x190000;    // 25 units (Q16.16) manhattan from home

var wander_timer;          // persists across ticks (plain RAM)
var taunt_timer;           // occasional speech while fighting

fn dist_manhattan(x1, y1, x2, y2) {
    return abs(x1 - x2) + abs(y1 - y2);
}

fn main() {
    self_status(SELF);

    // Too far from home? Walk back (out-of-combat regen heals us).
    if (dist_manhattan(mem[SELF], mem[SELF + 4],
                       mem[SELF + 36], mem[SELF + 40]) > LEASH) {
        move_to(mem[SELF + 36], mem[SELF + 40]);
        return;
    }

    // Chase and hit the nearest enemy inside our aggro radius that we
    // can SEE — prey behind a cliff would pin us against it (steering
    // has no pathfinding), and a wall of straining monsters reads as
    // "stuck", not "menacing".
    var nen = read_entities(ENTS, 4, F_ENEMY);
    var target = -1;
    var tx = 0;
    var ty = 0;
    var k = 0;
    while (k < nen) {
        var cand = ENTS + k * 24;
        var cx = mem[cand + 8];
        var cy = mem[cand + 12];
        if (dist_manhattan(cx, cy, mem[SELF], mem[SELF + 4]) <= mem[SELF + 44]) {
            if (line_of_sight(cx, cy) == 1) {
                target = mem[cand];
                tx = cx;
                ty = cy;
                k = nen;
            }
        }
        k = k + 1;
    }
    if (target >= 0) {
        // A word for the prey, now and then (defs without lines just
        // fail the call — harmless).
        taunt_timer = taunt_timer - 1;
        if (taunt_timer <= 0) {
            say((random() & 0x7FFFFFFF) % 8);
            taunt_timer = 80 + (random() & 0x7FFFFFFF) % 120;
        }
        // Lead with the first READY kit slot, aimed per its mode (#54 PR2a:
        // +28 target_mode, +32 ready in the 10-word record; +36 life_cost, #98).
        var used = -1;
        var n = read_skills(SKL, 4);
        var i = 0;
        while (i < n) {
            var rec = SKL + i * 40;
            if (mem[rec + 32] == 1) {
                if (mem[rec + 28] == 0) { used = use_skill(i + 1, target, 0, 0); }
                if (mem[rec + 28] == 1) { used = use_skill_at(i + 1, tx, ty); }
                if (mem[rec + 28] == 2) {
                    used = use_skill_dir(i + 1, tx - mem[SELF], ty - mem[SELF + 4]);
                }
                if (used == 0) { i = n; }
            }
            i = i + 1;
        }
        if (used != 0) {
            use_skill(0, target, 0, 0);
        }
        move_to(tx, ty);
        return;
    }

    // Idle: pick a fresh wander point near home every 3-9 seconds.
    wander_timer = wander_timer - 1;
    if (wander_timer <= 0) {
        move_to(mem[SELF + 36] + (random() & 0x7FFFFFFF) % 0x80000 - 0x40000,
                mem[SELF + 40] + (random() & 0x7FFFFFFF) % 0x80000 - 0x40000);
        wander_timer = 30 + (random() & 0x7FFFFFFF) % 60;
    }
}
