// A depth-gauge that learned to argue. Act 2's wand rung. (#148 A3)
ItemDef(
    id: "pressure_wand",
    public: true,
    name: "Pressure Wand",
    model: "wand",
    slot: weapon,
    weapon_class: Some(wand),

    w: 1,
    h: 3,
    damage_phys: 24,
    damage_lightning: 12,
    range_cu: 900,
    use_ticks: 9,
    projectile: true,
    // The caster's gear curve (quality pass): spells ignore weapon damage,
    // so the wand speaks through its IMPLICIT instead.
    spell_damage_bp: 10000,
    weight: 55,
    affix_pools: ["weapon"],
)
