// The endgame in your bag (#136 T4): a salt-stained map of waters no
// living runner drew. Used at the Last Harbor's Map Device (once the
// campaign falls), it opens a mapped instance — the tier rises with the drop's
// item level, and the obols craft the map like any other item: rolled
// quantity pays in loot, rolled rarity in juiced packs.
ItemDef(
    id: "salt_stained_chart",
    public: true,
    name: "Salt-Stained Map",
    // Nominal slot only — maps are CARGO: the equip path refuses any
    // map_tier item (manual equip -1, auto score 0), so this never wears.
    slot: flask,
    w: 2,
    h: 2,
    // Never in the common droppool — maps drop ONLY via the dedicated
    // roll (act-boss kills + inside mapped instances).
    weight: 0,
    map_tier: Some(1),
    affix_pools: ["chart"],
)
