// The Mother's second signature (#136 T5): a caster's wand strung with
// choir-teeth. Her storms, lent — crits seek, and the sea pays the mana.
UniqueDef(
    id: "drowned_verse",
    name: "Drowned Verse",
    base: "barnacle_wand",
    lore: "Sing it back to her and see.",
    mods: [
        (stat: damage_lightning, layer: added, value: 6),
        (stat: cast_speed, layer: increased, value: 1200),
        (stat: crit_chance, layer: increased, value: 4000),
        (stat: leech_mana, layer: added, value: 200),
    ],
    drop_from: "mother_of_the_drowned",
    drop_bp: 900,
)
