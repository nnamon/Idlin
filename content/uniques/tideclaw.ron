// The Tidewarden's signature (#136 T5): the grip that holds the strand.
// Cold bites on every swing, the swings come faster, and what it touches
// slows — the tutorial's final lesson, wearable.
UniqueDef(
    id: "tideclaw",
    name: "Tideclaw",
    base: "rusted_cleaver",
    lore: "The strand keeps what the tide brings it.",
    mods: [
        (stat: damage_cold, layer: added, value: 8),
        (stat: attack_speed, layer: increased, value: 1500),
        (stat: chill_chance, layer: added, value: 2500),
    ],
    drop_from: "tidewarden",
    drop_bp: 800,
)
