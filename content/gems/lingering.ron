// Support: what the supported skill leaves behind, stays longer —
// dots, buffs, and debuffs all stretch.
GemDef(
    id: "lingering",
    name: "Lingering",
    kind: support,
    weight: 60,
    requires_tags: [duration],
    effects: [
        dot_duration_inc(bp: 4000),     // 40% longer riders
        mana_mult(bp: 1000),            // 110% mana cost
    ],
)
