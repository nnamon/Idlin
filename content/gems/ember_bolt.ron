// Skill: a mote of stolen fire. A true spell — its fire is its own,
// growing with the gem, and it cannot miss.
GemDef(
    id: "ember_bolt",
    public: true,
    name: "Ember Bolt",
    kind: skill,
    skill_kind: spell,
    target_mode: entity,
    tags: [spell, projectile, fire],
    weight: 60,
    shape: projectile,
    proj_speed_cps: 1500,
    range_cu: 900,
    added_fire: (base: 9, per_level: 3),
    crit_bp: 600,
    cast_ticks: 7,
    mana_cost: (base: 6, per_level: 1),
)
