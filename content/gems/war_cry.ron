// Skill: a wordless roar from the wreck-line. No damage — every ally
// in earshot (the caster included) hits harder for a while.
// Direction-aimed so it needs no enemy to fire (use_skill_dir).
GemDef(
    id: "war_cry",
    public: true,
    name: "War Cry",
    kind: skill,
    skill_kind: spell,
    target_mode: direction,
    tags: [aoe, duration],
    weight: 60,
    shape: nova,
    radius_cu: 500,
    max_targets: 1,
    cast_ticks: 6,
    cooldown_ticks: 80,     // special: a real cooldown
    mana_cost: (base: 12, per_level: 0),
    buff: Some(BuffDef(
        grants: [
            (stat: damage_phys, layer: increased, value: 2500),
        ],
        duration_ticks: 100,    // ten loud seconds
    )),
)
