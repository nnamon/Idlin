// Support: the supported spell leaves the hands faster.
GemDef(
    id: "swift_casting",
    name: "Swift Casting",
    kind: support,
    weight: 70,
    requires_tags: [spell],
    effects: [
        inc_cast_speed(bp: 2000),       // 20% increased cast speed
        mana_mult(bp: 500),             // 105% mana cost
    ],
)
