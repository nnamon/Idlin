// Skill: a drifting blight dropped on ground you choose (UseSkillAt).
// The touch is nothing; the rot is the point.
GemDef(
    id: "plague_cloud",
    name: "Plague Cloud",
    kind: skill,
    skill_kind: spell,
    target_mode: point,
    tags: [spell, chaos, aoe, duration],
    weight: 60,
    shape: point_aoe,
    range_cu: 700,
    radius_cu: 300,
    max_targets: 6,
    added_chaos: (base: 2, per_level: 1),
    crit_bp: 500,
    cast_ticks: 10,
    mana_cost: (base: 10, per_level: 1),
    dot: Some(DotDef(
        dtype: chaos,
        per_second: (base: 6, per_level: 2),
        duration_ticks: 50,     // five seconds of rot
    )),
)
