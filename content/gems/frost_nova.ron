// Skill: a ring of stolen winter. Everything caught is chilled — slower to move
// and to swing. The chill is now a first-class CHILL AILMENT (#88): cold hits
// inflict it, and Frost Nova carries an inherent 100% chance so it reliably
// chills (the slow magnitude scales from the cold hit, capped by Chill's cap).
GemDef(
    id: "frost_nova",
    public: true,
    name: "Frost Nova",
    kind: skill,
    skill_kind: spell,
    target_mode: entity,
    tags: [spell, cold, aoe],
    weight: 70,
    shape: nova,
    radius_cu: 380,
    max_targets: 6,
    added_cold: (base: 7, per_level: 3),
    crit_bp: 600,
    ailment_chance: 10000,  // #88: reliably chills what it catches
    cast_ticks: 8,
    mana_cost: (base: 8, per_level: 1),
)
