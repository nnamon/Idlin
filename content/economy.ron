// The vendor economy (#185 C8, operator-ruled): obols carry a 0.1
// denomination — every count in the game is integer TENTHS (10 = one
// whole obol). Selling pays a TRICKLE of the rarity-matched obol;
// crafting consumes whole obols; dropped obols are whole. Tune the
// economy here, not in engine source.
EconomyDef(
    // Tenths paid per sale: 1 = a tenth of an obol.
    sell_pays_tenths: 1,
    // Paid per sold rarity: normal, magic, rare, unique.
    sell_obols: ("transmute_obol", "alter_obol", "alchemy_obol", "regal_obol"),
    // Sold gems and maps pay this.
    sell_obol_gem: "transmute_obol",
    // The town chest's slot cap.
    stash_cap: 40,
)
