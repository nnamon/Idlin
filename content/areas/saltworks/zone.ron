// Act 1, step three: the Saltworks — the old evaporation pans above the
// coast, still worked by what the brine preserved. The first WALLED zone:
// plank walkways between pans funnel the fighting, and Brinelord Karesh
// holds the overseer's court at the north end. Like every zone, the pans
// hold what the brine preserved and no more — cleared is cleared.
ZoneDef(
    id: "saltworks",
    name: "The Saltworks",
    kind: story,
    level: 12,
    tileset: Some("town"),
    spawn_x_u: 22,
    spawn_y_u: 50,
    spawn_radius_u: 2,
    camp_radius_u: 6,
    brain: Some("saltworks"),
    lines: [
        (id: "enter", text: "The Saltworks. The pans still steam. Nothing living tends them."),
        (id: "court", text: "The overseer's court. Something in there remembers having a name."),
        (id: "narrows",  text: "Wights hold the walkways. Planks make the fight two-wide — pull them TO you. The open pans make it six-wide. Don't fight six-wide."),
        (id: "overseer", text: "Karesh. Wounded, he throws what he holds. When the shoving starts, give ground — the pans keep what falls in."),
    ],
    packs: [
        // The pan field, south to north: haunts throw embers off the rims,
        // wights hold the walkways.
        SpawnPack(monster: "pan_haunt",   count: 5, x_u: 17, y_u: 18, radius_u: 2, magic_bp: 2000, rare_bp: 700),
        SpawnPack(monster: "brine_wight", count: 5, x_u: 22, y_u: 24, radius_u: 2, magic_bp: 2000, rare_bp: 700),
        SpawnPack(monster: "pan_haunt",   count: 5, x_u: 26, y_u: 29, radius_u: 2, magic_bp: 2000, rare_bp: 700),
        SpawnPack(monster: "brine_wight", count: 7, x_u: 10, y_u: 35, radius_u: 2, magic_bp: 2000, rare_bp: 700),
        SpawnPack(monster: "pan_haunt",   count: 5, x_u: 22, y_u: 40, radius_u: 2, magic_bp: 2500, rare_bp: 900),
        SpawnPack(monster: "brine_wight", count: 7, x_u: 33, y_u: 45, radius_u: 2, magic_bp: 2500, rare_bp: 900),
        // The court: two wight honor guards, then the Brinelord himself.
        // Uniques spawn Unique by def; every idler's private saltworks
        // holds its own Brinelord.
        SpawnPack(monster: "brine_wight",      count: 4, x_u: 16, y_u: 8, radius_u: 2),
        SpawnPack(monster: "brinelord_karesh", count: 1, x_u: 22, y_u: 6, radius_u: 0),
    ],
    exits: [
        // Back down to the Drowned Coast.
        (x_u: 21, y_u: 53, dest: "coast", open: true),
        // Through the court to the Hollow — walking past Karesh is the gate.
        (x_u: 21, y_u: 0, dest: "hollow", open: true),
    ],
)
