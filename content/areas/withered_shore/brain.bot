// ============================================================
// Area brain: The Withered Shore. The dungeon master is a bot.
//
// The GATED TUTORIAL: every gate is a lesson, lifted when it lands.
//   0. Declare a build (the start gate answers intent)
//   1. One staked kill  -> weapon + life flask, gate "first" lifts
//   2. One more kill    -> suited skill gem,    gate "second" lifts
//   3. The gauntlet     -> many weak biters force the flask; stand
//                          whole again and gate "gauntlet" lifts
//   4. The open strand  -> real packs
//   5. The Shoal Witch  -> a scripted MAGIC elite pays a support gem
//                          + mana flask; SOCKET it and gate "midway"
//                          lifts (power borrowed is power paid for)
//   6. Harder packs     -> with a guaranteed scripted RARE among them
//   7. The Tidewarden   -> the hoard, and the bluff path to Saltmere
//
// Content is referenced BY NAME (`item "..."`, `line "..."`) and
// resolved at load — adding content never shifts what this means.
// ============================================================

include "zone_lib.bot";

const IT_WAND = item "barnacle_wand";
const IT_BOW = item "driftwood_bow";
const IT_CLEAVER = item "rusted_cleaver";
const IT_FLASK = item "small_life_flask";
const IT_MANAFLASK = item "small_mana_flask";
const GEM_ARC = gem "arc";
const GEM_CLEAVE = gem "cleave";
const GEM_EMBER = gem "ember_bolt";
const GEM_FROST = gem "frost_nova";
const GEM_HEAVY = gem "heavy_swing";
const GEM_PLAGUE = gem "plague_cloud";
const GEM_SHOT = gem "power_shot";
const SUP_QUICKENING = gem "quickening";
const SUP_SWIFT = gem "swift_casting";
const SUP_WIDENING = gem "widening";
const CUR_TRANSMUTE = currency "transmute_obol";
const MON_TIDEWARDEN = monster "tidewarden";
const MON_WITCH = monster "shoal_witch";
const MON_STALKER = monster "bone_stalker";

// Narration (zone.ron `lines:`), by id.
const L_WELCOME = line "welcome";
const L_FIRSTKILL = line "firstkill";
const L_ARMED = line "armed";
const L_GEM = line "gem";
const L_SOCKET = line "socket";
const L_LEVEL = line "level";
const L_OBOL = line "obol";
const L_WRECKS = line "wrecks";
const L_STALKERS = line "stalkers";
const L_BOSSDOWN = line "bossdown";
const L_BOSSWARN = line "bosswarn";
const L_DEPART = line "depart";
const L_DECLARE = line "declare";
const L_PATHSET = line "pathset";
const L_GAUNTLET = line "gauntlet";
const L_FLASKLESSON = line "flasklesson";
const L_RECOVERED = line "recovered";
const L_ELITE = line "elite";
const L_ELITEDOWN = line "elitedown";
const L_MANACOST = line "manacost";
const L_RARE = line "rare";

// The lesson ladder (gates by id) and the bluff-path exit (by dest).
// The brain only GATES things open — walking through is always the
// character's own bot's decision (use_exit); no forced moves.
const EXIT_SALTMERE = exit "saltmere";
const GATE_START = gate "start";
const GATE_FIRST = gate "first";
const GATE_SECOND = gate "second";
const GATE_GAUNTLET = gate "gauntlet";
const GATE_MIDWAY = gate "midway";

// beat flags (zl_once bits)
const F_WELCOME = 1;
const F_WEAPON = 2;
const F_ARMED = 4;
const F_GEMDROP = 8;
const F_SOCKET = 16;
const F_LEVEL = 32;
const F_OBOL = 64;
const F_Y70 = 128;
const F_Y40 = 256;
const F_BOSSWARN = 512;
const F_PATH = 1024;
const F_PATHSET = 2048;
const F_GAUNTWARN = 4096;
const F_HURT = 8192;
const F_RECOVER = 16384;
const F_ELITE = 32768;
const F_ELITEDOWN = 65536;
const F_MANACOST = 131072;

// The gauntlet is cleared at this kill tally (beats 1+2 = 2, plus the
// six grasping dead) — the gate waits for the tally AND full health.
const GAUNTLET_KILLS = 8;

fn main() {
    var nq = query_characters(ZL_Q, ZL_MAX_CHARS);

    // -- state-driven beats: the lesson ladder, south to north --
    var i = 0;
    while (i < nq) {
        var r = ZL_Q + i * CHAR_RECORD_SIZE;
        var net = mem[r + QC_NET];
        var kills = mem[r + QC_KILLS];
        var x = mem[r + QC_X];
        var y = mem[r + QC_Y];
        var life = mem[r + QC_LIFE];

        zl_narrate_once(net, F_WELCOME, L_WELCOME);

        // Lesson 0: declare a build. The starting gate answers intent —
        // and the declared ARCHETYPE steers the weapon drop later.
        var bl = mem[r + QC_BUILD];
        var arch = mem[r + QC_ARCH];
        if (bl == 0) {
            zl_narrate_once(net, F_PATH, L_DECLARE);
        }
        if (bl > 0) {
            if (zl_once(net, F_PATHSET) == 1) {
                set_gate(GATE_START, 1);
                narrate(L_PATHSET, net);
            }
        }

        // NOTE: && is EAGER in this language (both sides always run) —
        // side-effecting calls like zl_once must sit INSIDE the gate,
        // never beside it.
        // Lesson 1: the first kill pays a weapon + the life flask; the
        // declared path picks the weapon, the undeclared get the tide's
        // choice. The "first" gate lifts with the drop.
        if (kills >= 1) {
            if (zl_once(net, F_WEAPON) == 1) {
                var base = IT_CLEAVER;
                if (arch == 1) { base = IT_BOW; }
                if (arch == 2) { base = IT_WAND; }
                if (arch < 0) {
                    var w = (random() & 0x7FFFFFFF) % 3;
                    if (w == 1) { base = IT_BOW; }
                    if (w == 2) { base = IT_WAND; }
                }
                drop_loot(0, base, x, y, net);
                drop_loot(0, IT_FLASK, x, y, net);
                narrate(L_FIRSTKILL, net);
                set_gate(GATE_FIRST, 1);
            }
        }
        // Lesson 2: the second kill pays a gem suited to the wielded
        // class; the "second" gate opens onto the gauntlet.
        if (kills >= 2) {
            if (zl_once(net, F_GEMDROP) == 1) {
                // Key on the DECLARED archetype first (#148 A2) — the same
                // trust the weapon payment shows. The wielded class lags
                // the declaration (a ranged pupil's bow lands six units
                // away at its kill and gets worn a breath later — lesson 2
                // once paid a SPELL to a bow build in that gap); intent is
                // declared, not worn.
                var g = GEM_EMBER;
                var ga = mem[r + QC_ARCH];
                if (ga < 0) { ga = mem[r + QC_WCLASS]; }
                if (ga == 0) {
                    g = GEM_CLEAVE;
                    if ((random() & 1) == 1) { g = GEM_HEAVY; }
                }
                if (ga == 1) { g = GEM_SHOT; }
                if (ga == 2 || ga < 0) {
                    var s = (random() & 0x7FFFFFFF) % 4;
                    if (s == 1) { g = GEM_FROST; }
                    if (s == 2) { g = GEM_ARC; }
                    if (s == 3) { g = GEM_PLAGUE; }
                }
                drop_loot(1, g, x, y, net);
                narrate(L_GEM, net);
                set_gate(GATE_SECOND, 1);
            }
        }
        // Lesson 3: the gauntlet. Warn at its mouth; coach the flask the
        // moment life runs low; lift the gate only for a survivor made
        // WHOLE again (the kill tally proves the swarm is down).
        if (y < 0x620000) { zl_narrate_once(net, F_GAUNTWARN, L_GAUNTLET); }
        if (life <= 40) { zl_narrate_once(net, F_HURT, L_FLASKLESSON); }
        if (kills >= GAUNTLET_KILLS) {
            if (life >= 100) {
                if (zl_once(net, F_RECOVER) == 1) {
                    set_gate(GATE_GAUNTLET, 1);
                    narrate(L_RECOVERED, net);
                }
            }
        }
        // Lesson 5 opener: the Shoal Witch rises as a MAGIC elite just
        // before the midway gate, once the idler works down the strand.
        if (y < 0x3C0000) {
            if (zl_once(net, F_ELITE) == 1) {
                spawn_elite(MON_WITCH, 0xF0000, 0x3A0000, 1);
                narrate(L_ELITE, net);
            }
        }
        // The tenth corpse pays the ferryman.
        if (kills >= 10) {
            if (zl_once(net, F_OBOL) == 1) {
                drop_loot(2, CUR_TRANSMUTE, x, y, net);
                narrate(L_OBOL, net);
            }
        }
        // Story thresholds, marching north (y shrinks).
        if (y < 0x460000) { zl_narrate_once(net, F_Y70, L_WRECKS); }
        if (y < 0x280000) { zl_narrate_once(net, F_Y40, L_STALKERS); }
        if (y < 0x140000) { zl_narrate_once(net, F_BOSSWARN, L_BOSSWARN); }
        i = i + 1;
    }

    // -- event-driven beats: equips, sockets, the witch, the boss --
    var ne = poll_events(ZL_EVS, 32);
    var j = 0;
    while (j < ne) {
        var ev = ZL_EVS + j * EVENT_RECORD_SIZE;
        var kind = mem[ev + PE_KIND];
        var who = mem[ev + PE_WHO];
        if (kind == EV_EQUIP) { zl_narrate_once(who, F_ARMED, L_ARMED); }
        if (kind == EV_LEVEL) { zl_narrate_once(who, F_LEVEL, L_LEVEL); }
        if (kind == EV_SOCKET) {
            zl_narrate_once(who, F_SOCKET, L_SOCKET);
            // Lesson 5 close: a socket AFTER the witch's gem dropped is
            // the support lesson landing — mana costs rise, the blue
            // flask services the debt, and the midway gate lifts. The
            // guaranteed RARE rises among the packs beyond.
            var row = zl_state_row(who);
            if ((mem[row + 4] & F_ELITEDOWN) != 0) {
                if (zl_once(who, F_MANACOST) == 1) {
                    set_gate(GATE_MIDWAY, 1);
                    narrate(L_MANACOST, who);
                    // A rare STALKER, not a husk: a real fight for a
                    // level-3 pupil, one authored beat. Staked clear of
                    // the husk pack so they can't gang up.
                    spawn_elite(MON_STALKER, 0xE0000, 0x250000, 2);
                    narrate(L_RARE, 0);
                }
            }
        }
        if (kind == EV_KILL && mem[ev + PE_A] == MON_WITCH) {
            // Lesson 5 payoff: the witch's hoard — a support suited to
            // the wielded class, and the mana flask that pays for it.
            if (zl_once(who, F_ELITEDOWN) == 1) {
                var k = 0;
                while (k < nq) {
                    var qr = ZL_Q + k * CHAR_RECORD_SIZE;
                    if (mem[qr + QC_NET] == who) {
                        var sup = SUP_QUICKENING;
                        var wa = mem[qr + QC_ARCH];
                        if (wa < 0) { wa = mem[qr + QC_WCLASS]; }
                        if (wa == 2 || wa < 0) { sup = SUP_SWIFT; }
                        drop_loot(1, sup, mem[qr + QC_X], mem[qr + QC_Y], who);
                        drop_loot(0, IT_MANAFLASK, mem[qr + QC_X], mem[qr + QC_Y], who);
                        k = nq;
                    }
                    k = k + 1;
                }
                narrate(L_ELITEDOWN, who);
                // The support lesson may ALREADY be landed — a wild support
                // socketed before the witch leaves nothing to socket after
                // her, and the EV_SOCKET opener below can never re-fire
                // (found by the tri-archetype band: a pupil parked at the
                // midway gate forever with the witch dead and a spare
                // Quickening in the bag). Her kill opens the gate itself
                // when the socket beat has already happened.
                var wrow = zl_state_row(who);
                if ((mem[wrow + 4] & F_SOCKET) != 0) {
                    if (zl_once(who, F_MANACOST) == 1) {
                        set_gate(GATE_MIDWAY, 1);
                        narrate(L_MANACOST, who);
                        spawn_elite(MON_STALKER, 0xE0000, 0x250000, 2);
                        narrate(L_RARE, 0);
                    }
                }
            }
        }
        if (kind == EV_KILL && mem[ev + PE_A] == MON_TIDEWARDEN) {
            narrate(L_BOSSDOWN, 0);
            // The hoard lands at the killer's feet: a rolled rare and a
            // support — and the bluff-path exit to Saltmere swings open.
            // Walking through it is the killer's own decision (use_exit).
            var k2 = 0;
            while (k2 < nq) {
                var qr2 = ZL_Q + k2 * CHAR_RECORD_SIZE;
                if (mem[qr2 + QC_NET] == who) {
                    drop_loot(3, 8, mem[qr2 + QC_X], mem[qr2 + QC_Y], who);
                    var sup2 = (random() & 0x7FFFFFFF) % 3;
                    var sgem = SUP_QUICKENING;
                    if (sup2 == 1) { sgem = SUP_SWIFT; }
                    if (sup2 == 2) { sgem = SUP_WIDENING; }
                    drop_loot(1, sgem, mem[qr2 + QC_X], mem[qr2 + QC_Y], who);
                    k2 = nq;
                }
                k2 = k2 + 1;
            }
            set_exit(EXIT_SALTMERE, 1);
            narrate(L_DEPART, who);
        }
        j = j + 1;
    }
}
