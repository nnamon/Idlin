// Campaign zone 1: a long drowned strand. Idlers wash up at the south
// end and fight their way north along the waterline; packs grow nastier
// the further up the shore they push. The zone BRAIN (a bot, like
// everything else) choreographs the opening beats and the boss.
ZoneDef(
    id: "withered_shore",
    name: "The Withered Shore",
    kind: story,
    tileset: Some("shore"),
    spawn_x_u: 17,
    spawn_y_u: 122,
    spawn_radius_u: 7,
    // Sanctuary: monsters never acquire idlers resting at the camp.
    camp_radius_u: 10,
    // Story zones are SOLO: one idler per instance, as content not code.
    max_players: 1,
    brain: Some("withered_shore"),
    // Authored narration the brain fires by index (text = content,
    // WHEN = script).
    lines: [
        "The tide spits you onto the Withered Shore. Salt in your lungs. Get up.",
        "It stops moving. The dead give up their tools — take them.",
        "Armed. The shore feels smaller already.",
        "Something hums in the wreck-sand — a gem, warm against your palm.",
        "The gem takes. Your arm knows a new violence.",
        "The shore concedes a little strength. Your build remembers itself.",
        "An obol, salt-crusted. The dead paid the ferryman; you will spend it on steel.",
        "Wrecks thicken. These dead drowned angrier.",
        "Bone stalkers pace the dune line. Something north is feeding them.",
        "The Tidewarden breaks. The path up the bluffs lies open.",
        "The Tidewarden rises from the shallows, crowned in storm.",
        "You climb. Below, the shore keeps its dead. Above — firelight.",
    ],
    // Packs spawn (and respawn) as a unit: survivors hold their ground
    // until the whole pack is wiped, then the timer brings it back.
    // The opening is choreographed: a staked single, a pair, then a
    // ramp of 3/4/5 before the strand opens up.
    packs: [
        // ONE-SHOT waves (no respawns): the tutorial is a finite walk —
        // clear the strand, break the Tidewarden, take the bluff path.
        SpawnPack(monster: "drowned_shambler", count: 1, x_u: 17, y_u: 110, radius_u: 0, respawn_ticks: 9000000),
        SpawnPack(monster: "drowned_shambler", count: 2, x_u: 15, y_u: 104, radius_u: 2, respawn_ticks: 9000000),
        SpawnPack(monster: "drowned_shambler", count: 3, x_u: 16, y_u: 95,  radius_u: 3, respawn_ticks: 9000000),
        SpawnPack(monster: "bone_stalker",     count: 3, x_u: 14, y_u: 75,  radius_u: 4, respawn_ticks: 9000000),
        SpawnPack(monster: "tide_husk",        count: 3, x_u: 16, y_u: 50,  radius_u: 4, respawn_ticks: 9000000),
        SpawnPack(monster: "bone_stalker",     count: 4, x_u: 15, y_u: 30,  radius_u: 4, respawn_ticks: 9000000),
        // The boss holds the bluff path.
        SpawnPack(monster: "tidewarden",       count: 1, x_u: 17, y_u: 6,   radius_u: 0, respawn_ticks: 9000000),
    ],
    // The bluff path up to Saltmere, behind the boss. Starts shut; the
    // brain opens it when the Tidewarden falls — walking through is the
    // killer's own bot's decision (use_exit).
    exits: [
        (x_u: 17, y_u: 2, dest: "saltmere", open: false),
    ],
)
