// The Tidewarden: the thing feeding the strand. A drowned colossus
// crowned in storm — Arc from range, Frost Nova up close, and a War
// Cry that rallies every husk in earshot. The tutorial's final exam.
MonsterDef(
    id: "tidewarden",
    public: true,
    name: "The Tidewarden",
    model: "tidewarden",
    brain: "hostile_melee",
    hostile: true,
    unique: true,
    level: 8,
    // The final exam must be PASSABLE at the tutorial's natural level
    // (4-5): the strand is one-shot, so a pupil who can't break him has
    // no XP left to grow on — he is a wall with no ladder. Drama comes
    // from the flask economy, not raw numbers.
    life: 320,
    damage: 9,
    damage_cold: 2,
    armour: 35,
    evasion: 20,
    resist_lightning: 4000,
    resist_cold: 4000,
    speed_cps: 210,
    radius_cu: 70,
    range_cu: 200,
    use_ticks: 14,
    aggro_radius_cu: 1600,
    xp: 420,
    projectile: false,
    mana: 90,
    lines: [
        "THE TIDE KEEPS WHAT IT TAKES.",
        "You crawled OUT? Crawl back.",
        "Every wreck on this shore is mine.",
    ],
    // Phase kit (#136 T2): below half life the storm RISES. Strike-time
    // conditions fold per-strike through the effective-offense path (#109/
    // #125) for BOTH his spells and his swing, so the turn is real and
    // visible: storms crit twice as often and half again as hard, and the
    // colossus's fists land +60% (9 -> 14 phys). (Chosen to fold: only the
    // offensive subset re-derives per strike — cast/attack speed would not.)
    passives: [
        (stat: crit_chance, layer: increased, value: 10000, condition: Some(below_life_pct(5000))),
        (stat: crit_multi, layer: added, value: 5000, condition: Some(below_life_pct(5000))),
        (stat: damage_phys, layer: increased, value: 6000, condition: Some(below_life_pct(5000))),
    ],
    skills: [
        (gem: "arc", level: 3),
        (gem: "frost_nova", level: 3),
        (gem: "war_cry", level: 2),
    ],
)
