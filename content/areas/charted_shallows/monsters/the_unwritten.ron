// The TIER BOSS (#148 A4): the Unwritten — the thing the old maps
// refused to draw. Spawns only in Sovereign-Marked maps, at the far
// end, at its AUTHORED level (uniques never area-scale) — the ticket's
// fury and juice dials carry the tier's difficulty. Endurance-ratio tuned.
MonsterDef(
    id: "the_unwritten",
    public: true,
    name: "The Unwritten",
    model: "mother",
    brain: "hostile_melee",
    hostile: true,
    unique: true,
    level: 20,
    life: 3400,
    damage: 30,
    damage_cold: 10,
    speed_cps: 210,
    radius_cu: 100,
    range_cu: 230,
    mana: 260,
    passives: [
        (stat: crit_chance, layer: increased, value: 10000, condition: Some(below_life_pct(5000))),
        (stat: damage_cold, layer: increased, value: 6000, condition: Some(below_life_pct(2500))),
    ],
    skills: [
        (gem: "frost_nova", level: 4),
        (gem: "arc", level: 3),
        (gem: "war_cry", level: 3),
    ],
    use_ticks: 15,
    aggro_radius_cu: 1400,
    armour: 90,
    resist_cold: 2500,
    resist_lightning: 2500,
    xp: 6000,
    projectile: false,
    lines: [
        "No map holds me. Yours will not either.",
        "You walked PAST the edge of the drawn world. Bold.",
    ],
)
