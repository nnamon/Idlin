// Saltmere's townsfolk: survivors of the shore, now with errands.
// Non-hostile — life, not threat. (Id must sort AFTER "tidewarden":
// the shore brain pins monster indices.)
MonsterDef(
    id: "villager",
    public: true,
    name: "Survivor",
    model: "idler",
    brain: "villager",
    hostile: false,
    level: 1,
    life: 50,
    damage: 0,
    speed_cps: 160,        // 1.6 u/s — nobody hurries in Saltmere
    radius_cu: 40,
    range_cu: 100,
    use_ticks: 20,
    aggro_radius_cu: 0,
    armour: 0,
    xp: 0,
    projectile: false,
    lines: [
        "Cold night again.",
        "You came up from the shore? Then you've seen it.",
        "The braziers stay lit. That's the rule.",
        "Tide took the old town. We keep this one.",
        "Mind the gate after dark.",
        "The smith trades fair. The innkeep less so.",
    ],
)
