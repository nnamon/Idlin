// Area brain: the Tidewarden's Hollow — Act 1's last room. Greets each
// descent, and calls the basin when they reach the old water where the
// Mother stands.

include "zone_lib.bot";

const L_ENTER = line "enter";
const L_BASIN = line "basin";
const L_CHORUS = line "chorus";
const L_LAST = line "last_verse";

const MON_MOTHER = monster "mother_of_the_drowned";
const MON_DROWNED = monster "grasping_drowned";

// 0xE800+: clear of the var allocator (0xC000 up) and zone_lib's regions.
const MONS = 0xE800;

var phase;

const F_ENTERED = 1;
const F_BASIN = 2;

// The basin opens at the bottom of the throat (rows above y=23).
const BASIN_Y = 23;

fn main() {
    var nq = query_characters(ZL_Q, ZL_MAX_CHARS);
    var i = 0;
    while (i < nq) {
        var r = ZL_Q + i * CHAR_RECORD_SIZE;
        var net = mem[r + QC_NET];
        if (zl_once(net, F_ENTERED) == 1) {
            narrate(L_ENTER, net);
        }
        var y_u = mem[r + QC_Y] / 65536;
        if (y_u < BASIN_Y) {
            if (zl_once(net, F_BASIN) == 1) {
                narrate(L_BASIN, net);
            }
        }
        i = i + 1;
    }

    // The Mother's beats (#162 boss theatre): at half her chorus answers;
    // at a quarter the last verse raises everything she ever pulled under.
    var nm = query_monsters(MONS, 40);
    var k = 0;
    while (k < nm) {
        var m = MONS + k * MONSTER_RECORD_SIZE;
        if (mem[m + MON_NUM] == MON_MOTHER) {
            var life = mem[m + MON_LIFE];
            if (phase < 1 && life <= 50 && life > 0) {
                phase = 1;
                narrate(L_CHORUS, 0);
                spawn_monster(MON_DROWNED, 18 * 65536, 8 * 65536);
                spawn_monster(MON_DROWNED, 28 * 65536, 8 * 65536);
            }
            if (phase < 2 && life <= 25 && life > 0) {
                phase = 2;
                narrate(L_LAST, 0);
                spawn_monster(MON_DROWNED, 20 * 65536, 12 * 65536);
                spawn_monster(MON_DROWNED, 26 * 65536, 12 * 65536);
            }
        }
        k = k + 1;
    }
}
