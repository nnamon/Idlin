// Act 2's end (#148 A3): the Undertow — the current itself, coiled in a
// basin at the bottom of everything. The Riptide Sovereign holds it.
// Breaking him completes Act 2.
ZoneDef(
    id: "the_undertow",
    name: "The Undertow",
    kind: story,
    level: 19,
    tileset: Some("shore"),
    tileset_variant: Some("abyss"),
    spawn_x_u: 23,
    spawn_y_u: 54,
    spawn_radius_u: 2,
    camp_radius_u: 5,
    lines: [
        (id: "enter", text: "The Undertow. Every drowned thing ends up here. So did you."),
        (id: "basin", text: "The current stands. It has been waiting to meet you."),
        (id: "rises", text: "The Sovereign staggers — and the CURRENT RISES. The drowned answer."),
        (id: "breaks", text: "The crown cracks. Everything the tide ever took comes to hold it on."),
    ],
    brain: Some("the_undertow"),
    packs: [
        SpawnPack(monster: "choir_remnant", count: 7, x_u: 23, y_u: 44, radius_u: 3, magic_bp: 2800, rare_bp: 1000),
        // Pilgrims, not stranglers (quality pass): the spiral was a kill
        // box — the game's hardest-hitting trash in its narrowest corridor
        // (583 caster corpses). "Every drowned thing ends up here": the
        // stair's pilgrims fit the words and the fight.
        SpawnPack(monster: "pilgrim_husk", count: 7, x_u: 22, y_u: 34, radius_u: 3, magic_bp: 2800, rare_bp: 1000),
        SpawnPack(monster: "choir_remnant", count: 7, x_u: 24, y_u: 27, radius_u: 3, magic_bp: 3000, rare_bp: 1100),
        SpawnPack(monster: "choir_remnant", count: 1, x_u: 14, y_u: 14, radius_u: 2, magic_bp: 3000, rare_bp: 1200),
        SpawnPack(monster: "choir_remnant", count: 1, x_u: 32, y_u: 14, radius_u: 2, magic_bp: 3000, rare_bp: 1200),
        SpawnPack(monster: "riptide_sovereign", count: 1, x_u: 23, y_u: 8, radius_u: 0),
    ],
    exits: [
        (x_u: 23, y_u: 56, dest: "pressure_court", open: true),
    ],
)
