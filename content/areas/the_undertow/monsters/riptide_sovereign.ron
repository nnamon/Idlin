// ACT 2's END (#148 A3): the Riptide Sovereign — the current with a
// crown. Breaking him completes Act 2 (story bit 1).
//
// TUNING (the Mother's lesson, kept): an ENDURANCE fight — all-elemental
// damage vs whatever resists the road paid, so gem levels stay moderate
// and the LIFE pool carries the drama. Two per-strike phases.
MonsterDef(
    id: "riptide_sovereign", public: true, name: "The Riptide Sovereign",
    model: "mother", brain: "hostile_melee", hostile: true,
    unique: true,
    act_boss: Some(2),
    // 3000, not 4200 — the Mother's endurance ratio, scaled to level-21
    // fights (her 2000 worked at 15; doubling the pool re-created the
    // wall she taught us to remove).
    level: 21, life: 3000, damage: 28, damage_lightning: 10,
    speed_cps: 205, radius_cu: 105, range_cu: 230, mana: 300,
    passives: [
        (stat: crit_chance, layer: increased, value: 10000, condition: Some(below_life_pct(5000))),
        (stat: crit_multi, layer: added, value: 5000, condition: Some(below_life_pct(5000))),
        (stat: damage_lightning, layer: increased, value: 6000, condition: Some(below_life_pct(2500))),
        (stat: damage_phys, layer: increased, value: 4000, condition: Some(below_life_pct(2500))),
    ],
    skills: [
        (gem: "arc", level: 3),
        (gem: "frost_nova", level: 3),
        (gem: "war_cry", level: 3),
    ],
    use_ticks: 15, aggro_radius_cu: 1300, armour: 80,
    resist_cold: 2500, resist_lightning: 2500, resist_chaos: 2500,
    xp: 5200, projectile: false,
    lines: [
        "The tide was MY breathing.",
        "Everything sinks. I am where it stops.",
        "Wear the crown, then. It is heavier wet.",
    ],
)
