// Undertow trash: what is left of the Mother's choir, still singing.
MonsterDef(
    id: "choir_remnant", public: true, name: "Choir Remnant",
    model: "husk", brain: "hostile_melee", hostile: true,
    level: 19, life: 460, damage: 18, damage_cold: 8,
    speed_cps: 225, radius_cu: 60, range_cu: 240, mana: 200,
    // Nova L3 + NO lightning resist (quality pass): the first cut gave
