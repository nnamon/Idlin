// "... of Affliction" — the all-elemental ailment-chance suffix (#88). It is a
// HYBRID composed of the three PER-ELEMENT chances (ignite/shock/chill), each its
// own independent roll — NOT a single blanket "all ailments" lever, which would
// over-scale. Single-element affixes can target one chance off the same stats.
// Each rolled value is added to the attacker's chance for that element at proc time.
AffixDef(
    id: "of_affliction",
    public: true,
    name: "of Affliction",
    kind: suffix,
    pool: "weapon",
    // Rarer than the single-element chance affixes (of_kindling/of_conduction/
    // of_numbing, weight 50) — covering all three at once is the deliberate pick.
    weight: 20,
    effects: [
        (stat: ignite_chance, layer: added),
        (stat: shock_chance, layer: added),
        (stat: chill_chance, layer: added),
    ],
    tiers: [
        // +5-15% per element (each rolls independently).
        (ilvl: 1, name: "of Affliction", weight: 100, rolls: [(min: 500, max: 1500), (min: 500, max: 1500), (min: 500, max: 1500)]),
        // +15-30% per element.
        (ilvl: 8, name: "of Suffering", weight: 45, rolls: [(min: 1501, max: 3000), (min: 1501, max: 3000), (min: 1501, max: 3000)]),
    ],
)
