// "... of the Leech" — a HYBRID suffix (#86): one roll grants both life and mana
// leech (bp of damage returned, rate-capped in the engine).
AffixDef(
    id: "of_the_leech",
    public: true,
    name: "of the Leech",
    kind: suffix,
    weight: 50,
    effects: [
        (stat: leech_life, layer: added),
        (stat: leech_mana, layer: added),
    ],
    tiers: [
        (ilvl: 1, name: "of the Leech", weight: 100, rolls: [(min: 100, max: 200), (min: 150, max: 300)]),
        (ilvl: 5, name: "of the Vampire", weight: 35, rolls: [(min: 201, max: 350), (min: 301, max: 500)]),
    ],
)
