    effects: [(stat: resist_lightning, layer: added)],
    tiers: [
        (ilvl: 1, name: "of Storms", weight: 100, rolls: [(min: 500, max: 900)]),
        (ilvl: 3, name: "of Tempests", weight: 45, rolls: [(min: 901, max: 1500)]),
        (ilvl: 6, name: "of the Maelstrom", weight: 15, rolls: [(min: 1501, max: 2400)]),
    ],
)
