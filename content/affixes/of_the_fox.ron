// "... of the Fox" — a HYBRID suffix (#86): one roll grants both Dexterity and
// increased Evasion, each rolling independently in its own range.
AffixDef(
    id: "of_the_fox",
    public: true,
    name: "of the Fox",
    kind: suffix,
    weight: 55,
    effects: [
        (stat: dexterity, layer: added),
        (stat: evasion, layer: increased),
    ],
    tiers: [
        (ilvl: 1, name: "of the Fox", weight: 100, rolls: [(min: 5, max: 10), (min: 500, max: 900)]),
        (ilvl: 5, name: "of the Vulpine", weight: 40, rolls: [(min: 11, max: 18), (min: 901, max: 1500)]),
    ],
)
