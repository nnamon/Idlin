// "... of Numbing" — chance for your COLD hits to Chill (#88). The per-element
// counterpart to the all-elemental `of_affliction` hybrid (which composes all three
// chances); a single-element pick is the common case, the hybrid the deliberate one.
AffixDef(
    id: "of_numbing",
    public: true,
    name: "of Numbing",
    kind: suffix,
    pool: "weapon",
    weight: 50,
    effects: [(stat: chill_chance, layer: added)],
    tiers: [
        (ilvl: 1, name: "of Numbing", weight: 100, rolls: [(min: 500, max: 1500)]),    // +5-15%
        (ilvl: 8, name: "of Frostbite", weight: 45, rolls: [(min: 1501, max: 3000)]),  // +15-30%
    ],
)
