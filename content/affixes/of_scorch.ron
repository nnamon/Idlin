// "... of Scorch" — TARGET-DEPENDENT CONDITIONAL (#109 B2b, first content client):
// MORE fire damage WHILE THE VICTIM IS IGNITED. Unlike #109's self strike-time
// conditions (own life %), this reads the VICTIM, so it varies per hit within one
// use — an AoE that catches ignited and un-ignited enemies boosts only the burning
// ones. The sim collects it at derive and folds it per-victim in `World::strike`.
// First-pass magnitudes (flagged for playtest redline).
AffixDef(
    id: "of_scorch",
    public: true,
    name: "of Scorch",
    kind: suffix,
    weight: 30,
    effects: [(stat: damage_fire, layer: more, condition: Some(target_has_ailment(ignite)))],
    tiers: [
        (ilvl: 4, name: "of Scorch", weight: 100, rolls: [(min: 1000, max: 2000)]),    // +10-20% more
        (ilvl: 12, name: "of Immolation", weight: 40, rolls: [(min: 2001, max: 3000)]), // +20-30% more
    ],
)
