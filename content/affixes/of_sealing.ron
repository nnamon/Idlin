// "... of Sealing" — chaos resistance on armour (basis points, capped at use).
AffixDef(
    id: "of_sealing",
    public: true,
    name: "of Sealing",
    kind: suffix,
    weight: 70,
    effects: [(stat: resist_chaos, layer: added)],
    tiers: [
        (ilvl: 1, name: "of Sealing", weight: 100, rolls: [(min: 500, max: 1200)]),   // 5-12%
        (ilvl: 4, name: "of Purity", weight: 45, rolls: [(min: 1300, max: 2200)]),
    ],
)
