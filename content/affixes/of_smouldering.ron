// "... of Smouldering" — increased ailment duration (#88). For Ignite this spreads
// the same total over a longer burn (lower per-second); for Shock/Chill it simply
// lasts longer.
AffixDef(
    id: "of_smouldering",
    public: true,
    name: "of Smouldering",
    kind: suffix,
    weight: 40,
    effects: [(stat: ailment_duration, layer: added)],
    tiers: [
        (ilvl: 1, name: "of Smouldering", weight: 100, rolls: [(min: 1000, max: 2500)]),   // +10-25%
    ],
)
