// "... of Composure" — a flag: your critical strikes cannot cause ailments (#88).
// A build lever (a value of 1 sets the flag): crits no longer auto-inflict, leaving
// only the ailment-chance roll. Rare/low-weight — a deliberate pick, not a goal roll.
AffixDef(
    id: "of_composure",
    public: true,
    name: "of Composure",
    kind: suffix,
    pool: "weapon",
    weight: 10,
    effects: [(stat: crit_ailment_denied, layer: added)],
    tiers: [
        (ilvl: 6, name: "of Composure", weight: 100, rolls: [(min: 1, max: 1)]),   // a flag
    ],
)
