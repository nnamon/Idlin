AffixDef(
    id: "of_staggering_m", name: "of Staggering", kind: suffix, pool: "monster",
    public: true,
    weight: 40,
    effects: [(stat: stagger, layer: increased)],
    tiers: [
        (ilvl: 1, name: "of Staggering", weight: 100, rolls: [(min: 2000, max: 3500)]),
    ],
)
