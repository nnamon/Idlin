// Chart prefix (#136 T4): teeming waters — the instance's packs roll magic
// and rare far more often (the ticket adds this to every pack's bp).
AffixDef(
    id: "of_shoals",
    public: true,
    name: "Teeming",
    kind: prefix,
    weight: 100,
    effects: [(stat: item_rarity, layer: added)],
    tiers: [
        (ilvl: 1, name: "Teeming", weight: 100, rolls: [(min: 1500, max: 3000)]),
        (ilvl: 15, name: "Seething", weight: 40, rolls: [(min: 3001, max: 5000)]),
    ],
)
