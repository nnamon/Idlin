    id: "of_poise", name: "of Poise", kind: suffix,
    public: true,
    weight: 70,
    effects: [(stat: poise, layer: increased)],
    tiers: [
        (ilvl: 1, name: "of Poise", weight: 100, rolls: [(min: 1500, max: 2500)]),
        (ilvl: 7, name: "of Iron Poise", weight: 35, rolls: [(min: 2501, max: 4500)]),
    ],
)
