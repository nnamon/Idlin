// "... of Savagery" — CONDITIONAL (#86 Phase B mechanism, first content client):
// increased physical damage WHILE WIELDING MELEE (unarmed counts). Inert on a
// bow/wand — that's the conditional nature; a melee build rolls it on a melee weapon.
AffixDef(
    id: "of_savagery",
    public: true,
    name: "of Savagery",
    kind: suffix,
    pool: "weapon",
    weight: 50,
    effects: [(stat: damage_phys, layer: increased, condition: Some(wielding_weapon_class(melee)))],
    tiers: [
        (ilvl: 1, name: "of Savagery", weight: 100, rolls: [(min: 1500, max: 2500)]),   // +15-25%
        (ilvl: 4, name: "of Butchery", weight: 45, rolls: [(min: 2501, max: 4000)]),
    ],
)
