// "... of Casting" — increased cast speed on caster gear.
AffixDef(
    id: "of_casting",
    public: true,
    name: "of Casting",
    kind: suffix,
    weight: 60,
    effects: [(stat: cast_speed, layer: increased)],
    tiers: [
        (ilvl: 1, name: "of Casting", weight: 100, rolls: [(min: 800, max: 1400)]),     // +8-14%
        (ilvl: 4, name: "of Conjuring", weight: 45, rolls: [(min: 1401, max: 2200)]),
    ],
)
