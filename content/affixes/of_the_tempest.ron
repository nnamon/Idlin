// "... of the Tempest" — raises the cap on the Shock you inflict (#88): the
// Added layer lifts the default +40% ceiling, so big lightning hits shock harder.
AffixDef(
    id: "of_the_tempest",
    public: true,
    name: "of the Tempest",
    kind: suffix,
    weight: 35,
    effects: [(stat: shock_max, layer: added)],
    tiers: [
        (ilvl: 4, name: "of the Tempest", weight: 100, rolls: [(min: 300, max: 800)]),   // +3-8% cap
    ],
)
