// "... of the Hunt" — STRIKE-TIME CONDITIONAL (#109, RecentlyKilled tier):
// increased physical damage for a MOMENTUM WINDOW after a kill. recently_killed(40)
// = 40 ticks = 4s (TICK_HZ 10). Like the other strike-time affixes, the bonus folds
// into a per-strike effective sheet — it switches on the moment the wielder lands a
// kill and falls off when the window lapses. A close cousin of `of_desperation`
// (below-life), but rewarding aggression instead of desperation.
AffixDef(
    id: "of_the_hunt",
    public: true,
    name: "of the Hunt",
    kind: suffix,
    pool: "weapon",
    weight: 30,
    effects: [(stat: damage_phys, layer: increased, condition: Some(recently_killed(40)))],
    tiers: [
        (ilvl: 6, name: "of the Hunt", weight: 100, rolls: [(min: 1500, max: 3000)]),     // +15-30%
        (ilvl: 14, name: "of the Predator", weight: 40, rolls: [(min: 3001, max: 5000)]), // +30-50%
    ],
)
