// Chart suffix (#136 T4): the voyage pays — extra drop QUANTITY inside the
// charted instance (the ticket folds this into every kill's roll there).
AffixDef(
    id: "of_plenty",
    public: true,
    name: "of Plenty",
    kind: suffix,
    weight: 100,
    effects: [(stat: item_quantity, layer: added)],
    tiers: [
        (ilvl: 1, name: "of Plenty", weight: 100, rolls: [(min: 1500, max: 3000)]),
        (ilvl: 15, name: "of Bounty", weight: 40, rolls: [(min: 3001, max: 5000)]),
    ],
)
