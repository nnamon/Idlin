// Weapon prefix: stagger — your hits count as bigger against the
// victim's stun bar (see mechanics.md "Use timing" / hit reactions).
AffixDef(
    id: "jarring", name: "Jarring", kind: prefix,
    public: true,
    weight: 60,
    effects: [(stat: stagger, layer: increased)],
    tiers: [
        (ilvl: 1, name: "Jarring", weight: 100, rolls: [(min: 1500, max: 2500)]),
        (ilvl: 6, name: "Staggering", weight: 40, rolls: [(min: 2501, max: 4000)]),
    ],
)
