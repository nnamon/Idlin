{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/testing.ts",
    "tools/*/src/**/*.test.ts",
    "tools/*/src/**/*.d.ts"
  ]
}
